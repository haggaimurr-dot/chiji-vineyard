.profile-head { display: flex; align-items: center; gap: 24rpx; padding: 34rpx 10rpx; }
.avatar { display: flex; align-items: center; justify-content: center; width: 108rpx; height: 108rpx; border-radius: 50%; color: white; background: linear-gradient(135deg, var(--purple), var(--green)); font-size: 46rpx; font-family: serif; }
.nickname { font-size: 37rpx; font-weight: 700; }.welcome { margin-top: 8rpx; color: var(--muted); font-size: 23rpx; }
.order-card { padding: 30rpx; }.row-title { display: flex; justify-content: space-between; font-size: 29rpx; font-weight: 700; }.row-title text:last-child { color: var(--muted); font-size: 22rpx; font-weight: 400; }
.order-actions { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 34rpx; }.order-actions view { position: relative; display: flex; flex-direction: column; align-items: center; gap: 11rpx; font-size: 21rpx; }.icon { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 19rpx; color: var(--purple); background: #eee5f0; font-size: 24rpx; font-weight: 700; }.badge { position: absolute; top: -10rpx; right: 12rpx; min-width: 32rpx; height: 32rpx; padding: 0 8rpx; border-radius: 999rpx; color: white; background: #a54252; text-align: center; line-height: 32rpx; }
.menu { overflow: hidden; margin-top: 24rpx; }.menu view, .menu button { display: flex; justify-content: space-between; align-items: center; margin: 0; padding: 30rpx; width: 100%; border-bottom: 1rpx solid #eee8de; color: var(--ink); background: transparent; font-size: 27rpx; line-height: 1.4; text-align: left; }.menu view:last-child { border: 0; }.menu text:last-child { color: #aaa197; font-size: 36rpx; }
.brand-note { margin-top: 72rpx; text-align: center; color: var(--muted); }.brand-note view { color: var(--purple); font-family: serif; font-size: 32rpx; font-weight: 700; }.brand-note text { display: block; margin-top: 10rpx; font-size: 21rpx; }
