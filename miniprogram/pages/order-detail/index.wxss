.status { margin: 0 -28rpx 24rpx; padding: 48rpx 36rpx; color: white; background: linear-gradient(135deg,var(--purple),#31543d); }.status view { font-size: 42rpx; font-weight: 700; }.status text { display: block; margin-top: 12rpx; color: rgba(255,255,255,.7); font-size: 23rpx; }.address { display: grid; grid-template-columns: 55rpx 1fr; gap: 18rpx; padding: 28rpx; }.address > text { display: flex; align-items: center; justify-content: center; width: 50rpx; height: 50rpx; border-radius: 50%; color: white; background: var(--green); }.address view > view { font-weight: 700; }.address view > text { display: block; margin-top: 10rpx; color: var(--muted); font-size: 22rpx; line-height: 1.45; }.shipment,.goods,.detail { margin-top: 20rpx; padding: 28rpx; }.shipment view { font-weight: 700; }.shipment text { display: block; margin-top: 12rpx; color: var(--muted); }.good { display: grid; grid-template-columns: 110rpx 1fr auto; gap: 16rpx; margin-bottom: 18rpx; }.good:last-child { margin: 0; }.good image { width: 110rpx; height: 105rpx; border-radius: 12rpx; }.good > view:nth-child(2) view { font-weight: 700; }.good > view text { display: block; margin-top: 8rpx; color: var(--muted); font-size: 20rpx; }.good > view:last-child { text-align: right; }.detail > view { display: flex; justify-content: space-between; margin: 17rpx 0; color: var(--muted); font-size: 22rpx; }.detail .total { padding-top: 18rpx; border-top: 1rpx solid #eee8de; color: var(--ink); font-weight: 700; }.total text:last-child { color: var(--purple); font-size: 30rpx; }.actions { display: flex; justify-content: flex-end; gap: 14rpx; margin-top: 24rpx; padding-bottom: 40rpx; }.actions button { margin: 0; min-width: 190rpx; font-size: 24rpx; }


.tracking-actions{display:flex;gap:16rpx;margin:20rpx 0}.tracking-event{padding:22rpx 0;border-top:1rpx solid #eee;line-height:1.6}.tracking-event text,.tracking-time{font-size:24rpx;color:#888}

.review-panel { padding: 28rpx; }.review-title { font-weight: 700; font-size: 30rpx; }.review-hint { display: block; margin: 16rpx 0; color: var(--muted); font-size: 23rpx; line-height: 1.8; }.review-panel > button { margin-top: 16rpx; font-size: 24rpx; }.review-form { margin-top: 28rpx; }.rating-row { display: flex; align-items: center; margin: 20rpx 0; gap: 10rpx; }.rating-row button { padding: 0; margin: 0; width: 65rpx; color: #b4aca0; background: transparent; font-size: 40rpx; }.rating-row button::after { border: none; }.rating-row button.selected { color: var(--gold); }.review-form textarea { box-sizing: border-box; width: 100%; padding: 22rpx; background: #f4f0e7; border-radius: 12rpx; font-size: 25rpx; }.review-error { display: block; margin-top: 16rpx; color: #a33d39; font-size: 24rpx; }

.invoice-panel{padding:28rpx;margin-top:22rpx}.invoice-form input{margin:22rpx 0;padding:20rpx;background:#f7f3ec;border-radius:12rpx;font-size:24rpx}.invoice-form picker{padding:20rpx 0}.invoice-panel view{line-height:1.7}
.shipping-subscription{padding:28rpx;margin:22rpx 0}.shipping-subscription button{margin-top:16rpx;font-size:24rpx}.actions{flex-wrap:wrap}
.load-state{padding:20rpx 0;color:var(--muted);font-size:24rpx;line-height:1.7}.load-state button{margin:14rpx 0;width:220rpx}.load-error{color:#a33d39}.order-states{padding:20rpx 28rpx;margin-bottom:20rpx}.order-states view{display:flex;justify-content:space-between;gap:24rpx;padding:10rpx 0;font-size:24rpx}.order-states text:first-child{color:var(--muted)}

.review-photos{display:flex;flex-wrap:wrap;gap:12rpx;margin:16rpx 0}.review-photos image{width:160rpx;height:160rpx;border-radius:12rpx}.review-followup,.my-review{margin:18rpx 0;padding:18rpx;background:#f6f2ed;border-radius:12rpx;line-height:1.8}

.order-progress,.logistics-alerts{margin-top:20rpx;padding:28rpx}.progress-node{position:relative;margin-left:10rpx;border-left:2rpx solid #d9d2e4;padding:14rpx 0 24rpx 28rpx}.progress-node::before{content:"";position:absolute;left:-8rpx;top:24rpx;width:14rpx;height:14rpx;border-radius:50%;background:var(--purple)}.progress-node text{display:block;margin-top:8rpx;font-size:22rpx;color:var(--muted)}.progress-node.pending{color:var(--muted)}.progress-node.pending::before{background:#bbb}.progress-detail{margin-top:8rpx;font-size:24rpx;line-height:1.6}.logistics-alerts{background:#fff3ed;color:#a33d39}.logistics-alerts>view{margin-bottom:14rpx;line-height:1.6}

.package-box { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #e5e5df; overflow-wrap: anywhere; }
