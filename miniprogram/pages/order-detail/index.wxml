<view class="page page-pad safe-bottom">
  <view class="load-state" wx:if="{{loading}}">正在刷新订单…</view>
  <view class="load-state load-error" wx:elif="{{loadError}}"><text>{{loadError}}</text><button class="ghost-btn" bindtap="load">重试</button></view>
  <block wx:if="{{order}}">
  <view class="status"><view>{{order.statusText}}</view><text>{{order.statusHint}}</text></view>
  <view class="card order-states"><view><text>订单状态</text><text>{{order.orderStateText}}</text></view><view><text>付款状态</text><text>{{order.paymentStateText}}</text></view><view><text>配送状态</text><text>{{order.fulfillmentStateText}}</text></view><view><text>售后状态</text><text>{{order.refundStateText}}</text></view></view>
  <view class="card shipping-subscription">
    <view class="review-title">发货通知</view>
    <text class="review-hint">发货后可在「我的—发货通知」查看物流信息。{{demo ? '当前为演示环境，微信推送不发送。' : ''}}</text>
    <text class="review-hint" wx:if="{{subscription.status === 'READY'}}">已订阅，发货后发送一次微信提醒</text>
    <text class="review-hint" wx:elif="{{subscription.status === 'SENDING'}}">微信提醒发送结果待核实，请直接查看物流信息</text>
    <text class="review-hint" wx:elif="{{subscription.status === 'SENT'}}">{{demo ? '已模拟发送微信提醒' : '微信发货提醒已发送'}}</text>
    <text class="review-hint" wx:elif="{{subscription.status === 'UNCERTAIN'}}">推送结果待核实，请直接查看物流信息</text>
    <text class="review-hint" wx:elif="{{subscription.status === 'FAILED'}}">微信提醒发送失败，商家可重试发送</text>
    <text class="review-hint" wx:if="{{!subscription.enabled}}">微信提醒暂未开通，站内发货通知可正常查看</text>
    <button class="ghost-btn" wx:if="{{subscription.enabled && (subscription.status === 'NONE' || subscription.status === 'BLOCKED') && order.canSubscribeShipping}}" bindtap="subscribeShipping" loading="{{subscribeBusy}}" disabled="{{subscribeBusy || loading}}">{{demo ? '演示订阅发货通知' : '订阅微信发货通知'}}</button>
    <text class="review-error" wx:if="{{subscriptionError}}">{{subscriptionError}}</text>
    <button class="ghost-btn" wx:if="{{demo && order.canDemoShip}}" bindtap="demoShip" loading="{{loading}}" disabled="{{loading || actionBusy}}">模拟发货（演示）</button>
  </view>
  <view class="address card"><text>收</text><view><view>{{order.address.name}}　{{order.address.phone}}</view><text>{{order.address.province}}{{order.address.city}}{{order.address.district}}{{order.address.detail}}</text></view></view>
  <view class="card order-progress"><view class="review-title">订单进度时间线</view><view wx:for="{{progressNodes}}" wx:key="key" class="progress-node {{item.pending ? 'pending' : ''}}"><view>{{item.label}}</view><text>{{item.time || (item.pending ? '待完成' : '时间未记录')}}</text><view wx:if="{{item.detail}}" class="progress-detail">{{item.detail}}</view></view></view>
  <view class="card logistics-alerts" wx:if="{{logisticsAlerts.length}}"><view class="review-title">物流异常提醒</view><view wx:for="{{logisticsAlerts}}" wx:key="*this">{{item}}</view><button size="mini" open-type="contact">联系客服</button></view>
  <view class="shipment card" wx:if="{{order.shipment && !packages.length}}"><view>物流信息 · {{parcels.length}} 个包裹</view><picker wx:if="{{parcels.length > 1}}" range="{{parcelOptions}}" value="{{parcelIndex}}" bindchange="chooseParcel"><view>{{parcelOptions[parcelIndex]}} ›</view></picker><text>{{selectedParcel.carrier}}　{{selectedParcel.trackingNo}}</text><view class="tracking-actions"><button size="mini" bindtap="copyTracking">复制运单号</button><button size="mini" bindtap="track" loading="{{trackingLoading}}" disabled="{{trackingLoading}}">刷新轨迹</button></view><view wx:if="{{trackingError}}">{{trackingError}}</view><view wx:if="{{tracking}}"><view>{{tracking.message}}</view><text class="tracking-time">查询时间 {{tracking.updatedAt}}（半小时内复用查询结果）</text><view class="tracking-event" wx:for="{{tracking.events}}" wx:key="index"><text>{{item.time}}</text><view>{{item.context}}</view></view><view wx:if="{{!tracking.events.length}}">暂无轨迹节点</view></view></view>
  <view class="card" wx:if="{{packages.length}}"><view class="review-title">多包裹配送 · 共 {{packages.length}} 个</view><text class="review-hint">全部包裹发出后，请在收到全部商品时确认收货。</text><view class="package-box" wx:for="{{packages}}" wx:key="id" wx:for-item="parcel"><view>{{parcel.number}} · {{parcel.receivedAt ? '已收货' : parcel.shipment ? '已发货' : '待发货'}}</view><view wx:for="{{parcel.lines}}" wx:key="itemIndex">{{item.name}} {{item.skuName}} ×{{item.quantity}}</view><block wx:if="{{parcel.shipment}}"><view>{{parcel.shipment.carrier}} {{parcel.shipment.trackingNo}}</view><view class="tracking-actions"><button size="mini" data-id="{{parcel.id}}" bindtap="copyPackage">复制运单号</button><button size="mini" data-id="{{parcel.id}}" bindtap="trackPackage" loading="{{packageBusy === parcel.id}}" disabled="{{packageBusy}}">查询此包裹物流</button></view><block wx:if="{{packageTracking[parcel.id]}}"><view>{{packageTracking[parcel.id].message}}</view><view class="tracking-event" wx:for="{{packageTracking[parcel.id].events}}" wx:key="index"><text>{{item.time}}</text><view>{{item.context}}</view></view></block></block></view><text class="review-error" wx:if="{{packageError}}">{{packageError}}</text></view>
  <view class="card" wx:if="{{orderEvents.length}}"><view class="review-title">订单事件记录</view><view class="tracking-event" wx:for="{{orderEvents}}" wx:key="id"><view>{{item.detail}}</view><text>{{item.createdAt}}</text></view></view>
  <view class="goods card"><view class="good" wx:for="{{order.items}}" wx:key="skuId"><image src="{{item.product.cover || item.cover}}" mode="aspectFill"/><view><view>{{item.product.name || item.name}}</view><text>{{item.sku.name || item.skuName}} {{item.sku.weightLabel ? '· ' + item.sku.weightLabel : ''}}</text></view><view><text>¥{{item.lineText}}</text><text>×{{item.quantity}}</text></view></view></view>
  <view class="detail card"><view><text>订单编号</text><text>{{order.orderNo}}</text></view><view><text>下单时间</text><text>{{order.createdAt}}</text></view><view><text>商品金额</text><text>¥{{order.subtotalText}}</text></view><view><text>运费</text><text>¥{{order.freightText}}</text></view><view wx:if="{{order.quote.discount}}"><text>优惠券抵扣</text><text>−¥{{order.discountText}}</text></view><view><text>配送日期</text><text>{{order.deliveryDate || '尽快配送'}}</text></view><view class="total"><text>实付金额</text><text>¥{{order.totalText}}</text></view></view>
  <view class="card invoice-panel"><view class="review-title">发票申请</view><view wx:if="{{order.invoice}}"><text>{{order.invoice.status === 'APPLIED' ? (order.invoice.autoStatus === 'PROCESSING' ? '自动开票中' : order.invoice.autoStatus === 'UNCERTAIN' ? '开票结果核实中' : order.invoice.autoStatus === 'FAILED' ? '开票失败，商家将处理' : order.invoice.autoStatus === 'BLOCKED' ? '退款期间暂停开票' : '等待开票') : order.invoice.status === 'ISSUED' ? '已开票' : '申请被退回'}}</text><view>{{order.invoice.title}}</view><text class="review-hint">{{order.invoice.email}}</text><view>申请金额：{{order.invoiceAmountText}}</view><view wx:if="{{order.invoice.number}}">发票号码：{{order.invoice.number}}</view><view wx:if="{{order.invoice.status === 'ISSUED'}}">{{order.invoiceEmailText}}</view><button class="ghost-btn" wx:if="{{order.invoice.fileName}}" bindtap="viewInvoice" loading="{{invoiceBusy}}" disabled="{{invoiceBusy}}">下载发票</button><text class="review-hint" wx:if="{{order.invoice.fileName}}">打开 PDF 后，可通过右上角菜单保存或转发。</text><view wx:if="{{order.invoice.reason}}">{{order.invoice.reason}}</view></view><button class="ghost-btn" wx:if="{{order.paymentStatus === 'PAID' && (order.refundStatus === 'NONE' || order.refundStatus === 'REJECTED') && (!order.invoice || order.invoice.status === 'REJECTED')}}" bindtap="openInvoice" disabled="{{invoiceBusy}}">{{invoiceOpen ? '收起申请' : order.invoice ? '重新申请' : '申请电子普通发票'}}</button><text class="review-hint" wx:if="{{!order.invoice && order.paymentStatus !== 'PAID'}}">付款后可申请</text><text class="review-error" wx:if="{{invoiceError && !invoiceOpen}}">{{invoiceError}}</text><view class="invoice-form" wx:if="{{invoiceOpen}}"><picker range="{{['个人','企业']}}" bindchange="invoiceKind" disabled="{{invoiceBusy}}"><view>抬头类型：{{invoiceKind === 'personal' ? '个人' : '企业'}} ›</view></picker><input placeholder="发票抬头（必填）" maxlength="100" value="{{invoiceTitle}}" data-field="invoiceTitle" bindinput="invoiceField" disabled="{{invoiceBusy}}"/><input wx:if="{{invoiceKind === 'company'}}" placeholder="企业税号（必填）" maxlength="20" value="{{invoiceTaxId}}" data-field="invoiceTaxId" bindinput="invoiceField" disabled="{{invoiceBusy}}"/><input placeholder="接收邮箱（必填）" maxlength="200" value="{{invoiceEmail}}" data-field="invoiceEmail" bindinput="invoiceField" disabled="{{invoiceBusy}}"/><text class="review-hint">按订单实付金额申请，开具后自动发送至邮箱；开票后可在此下载发票，打开后通过右上角菜单保存或转发。</text><text class="review-error" wx:if="{{invoiceError}}">{{invoiceError}}</text><button class="primary-btn" bindtap="submitInvoice" loading="{{invoiceBusy}}" disabled="{{invoiceBusy}}">提交申请</button></view></view>
  <view class="card review-panel" wx:if="{{order.orderStatus === 'COMPLETED' && order.fulfillmentStatus === 'RECEIVED' && order.paymentStatus === 'PAID'}}">
    <view class="review-title">评价本次鲜果</view><text class="review-hint">每款商品可评价和追评各一次；新评价及追评审核通过后公开匿名展示，商家回复随评价展示，请勿上传个人信息。</text>
    <view wx:if="{{reviewsLoadError}}"><text class="review-error">{{reviewsLoadError}}</text><button bindtap="loadMyReviews">重试加载评价</button></view>
    <view wx:for="{{myReviews}}" wx:key="id" class="my-review"><view class="review-hint">{{item.status === 'PENDING' ? '待审核，暂未公开' : item.status === 'REJECTED' ? '已驳回，暂未公开' : '审核通过'}}</view><view wx:if="{{item.rejectReason}}" class="review-error">驳回原因：{{item.rejectReason}}</view><view>{{item.content}}</view><view class="review-photos"><image wx:for="{{item.images}}" wx:for-item="photo" wx:key="*this" src="{{photo}}" mode="aspectFill" data-url="{{photo}}" data-urls="{{item.images}}" bindtap="previewReviewImage"/></view><view wx:if="{{item.appendContent}}">追评：{{item.appendContent}}</view><view class="review-photos"><image wx:for="{{item.appendImages}}" wx:for-item="photo" wx:key="*this" src="{{photo}}" mode="aspectFill" data-url="{{photo}}" data-urls="{{item.appendImages}}" bindtap="previewReviewImage"/></view><view wx:if="{{item.reply}}">商家回复：{{item.reply}}</view></view>
    <button wx:for="{{order.items}}" wx:key="skuId" class="ghost-btn" data-id="{{item.productId}}" bindtap="startReview" disabled="{{reviewBusy || reviewImageBusy || reviewsLoadError || item.reviewDone}}">{{item.reviewLabel || '评价'}} {{item.product.name || item.name}}</button>
    <view wx:if="{{reviewProductId}}" class="review-form">
      <view>{{reviewId ? '追加评价' : '首次评价'}} · {{reviewName}}</view><view wx:if="{{!reviewId}}" class="rating-row"><button wx:for="{{reviewStars}}" wx:key="*this" data-rating="{{item}}" bindtap="setReviewRating" disabled="{{reviewBusy || reviewImageBusy}}" aria-label="{{item}} 星" class="{{reviewRating >= item ? 'selected' : ''}}">★</button><text>{{reviewRating}} 星</text></view>
      <textarea placeholder="分享口感、新鲜度和包装体验（最多500字）" maxlength="500" value="{{reviewContent}}" bindinput="setReviewContent" disabled="{{reviewBusy || reviewImageBusy}}"/>
      <view class="review-photos"><view wx:for="{{reviewImages}}" wx:key="path"><image src="{{item.path}}" mode="aspectFill"/><button data-index="{{index}}" bindtap="removeReviewImage" disabled="{{reviewBusy || reviewImageBusy}}">移除</button></view></view><button bindtap="chooseReviewImages" loading="{{reviewImageBusy}}" disabled="{{reviewBusy || reviewImageBusy || reviewImages.length >= 6}}">添加晒图（{{reviewImages.length}}/6）</button>
      <text class="review-error" wx:if="{{reviewError}}">{{reviewError}}</text>
      
  <view class="actions"><button class="ghost-btn" bindtap="cancelReview" disabled="{{reviewBusy || reviewImageBusy}}">取消</button><button class="primary-btn" bindtap="submitReview" loading="{{reviewBusy}}" disabled="{{reviewBusy || reviewImageBusy}}">提交评价</button></view>
    </view>
  </view>
  <view class="card invoice-panel" wx:if="{{order.refundStatus !== 'NONE' || order.paymentStatus === 'REFUNDING' || order.paymentStatus === 'REFUNDED'}}"><view class="review-title">退款与售后</view><text class="review-hint">{{order.refundStateText}}，查看审核结果、拒绝原因及退款记录。</text><button class="ghost-btn" bindtap="refund">查看退款进度</button></view>
  <view wx:if="{{order.refundedAmount}}" class="card page-pad">累计已退 ¥{{order.refundedText}}</view><view class="actions"><button class="ghost-btn" bindtap="afterSales" wx:if="{{order.paymentStatus === 'PAID' || order.paymentStatus === 'REFUNDING' || order.paymentStatus === 'REFUNDED'}}">售后工单</button><button class="ghost-btn" bindtap="rebuy" loading="{{rebuyBusy}}" disabled="{{rebuyBusy}}">再次购买</button><button class="ghost-btn" wx:if="{{order.canPay}}" bindtap="cancel" disabled="{{loading || actionBusy}}">取消订单</button><button class="primary-btn" wx:if="{{order.canPay}}" loading="{{actionBusy}}" disabled="{{loading || actionBusy}}" bindtap="pay">继续支付</button><button class="ghost-btn" wx:if="{{order.canRefund}}" bindtap="refund" disabled="{{loading || actionBusy}}">申请退款 / 售后</button><button class="primary-btn" wx:if="{{order.canConfirm}}" bindtap="confirm" loading="{{actionBusy}}" disabled="{{loading || actionBusy}}">确认收货</button><button class="ghost-btn" open-type="contact">联系客服</button></view>
  <view class="card page-pad"><view class="review-title">本单批次</view><view wx:for="{{order.batches}}" wx:key="batchId"><view>{{item.batch.number}} × {{item.quantity}}</view><view>果园：{{item.batch.orchard}}</view><view>采收：{{item.batch.harvestedAt||'待采收'}} · 包装：{{item.batch.packedAt||'待包装'}}</view><button class="ghost-btn" data-code="{{item.batch.code||item.batch.id}}" bindtap="trace">查询溯源码</button></view><text wx:if="{{!order.batches.length}}">商家尚未登记本单批次</text></view>
  </block>
</view>



