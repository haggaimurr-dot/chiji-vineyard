.shop-head { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 4rpx 26rpx; }
.load-more { padding: 40rpx 20rpx; text-align: center; color: var(--muted); font-size: 24rpx; }
.load-more button { margin-top: 18rpx; display: inline-block; padding: 0 36rpx; }
.shop-title { color: var(--purple-dark); font-family: serif; font-size: 48rpx; font-weight: 700; }
.shop-copy { margin-top: 8rpx; color: var(--muted); font-size: 24rpx; }
.cart-entry { padding: 18rpx 25rpx; border-radius: 999rpx; color: var(--purple); background: #eee1f3; font-size: 24rpx; }
.filters { display: flex; gap: 14rpx; margin-bottom: 28rpx; }
.filter { padding: 16rpx 28rpx; border: 1rpx solid #ddd4c6; border-radius: 999rpx; color: var(--muted); background: rgba(255,255,255,.45); }
.filter.active { border-color: var(--purple); color: white; background: var(--purple); }
.product-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.product { overflow: hidden; }
.cover { width: 100%; height: 270rpx; background: #ddd; }
.body { padding: 21rpx; }
.tags { display: flex; align-items: center; justify-content: space-between; }
.stock { color: var(--green); font-size: 20rpx; }
.name { margin-top: 15rpx; font-size: 31rpx; font-weight: 700; }
.subtitle { margin-top: 6rpx; height: 64rpx; color: var(--muted); font-size: 22rpx; line-height: 1.45; }
.origin { margin-top: 10rpx; color: #8a826f; font-size: 20rpx; }
.price { margin-top: 16rpx; }

.search-bar { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 22rpx; margin-bottom: 24rpx; border: 1rpx solid #e3dace; border-radius: 20rpx; background: var(--paper); }
.search-icon { color: var(--purple); font-size: 40rpx; }.search-bar input { flex: 1; min-width: 0; font-size: 25rpx; }.clear-search { padding: 0 10rpx; margin: 0; color: var(--purple); background: transparent; font-size: 23rpx; line-height: 2; }
.result-count { margin: 0 4rpx 20rpx; color: var(--muted); font-size: 23rpx; }.cover-wrap { position: relative; height: 270rpx; }.cover { display: block; }.image-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; background: #eee8dc; color: var(--muted); font-size: 22rpx; }.image-placeholder text:first-child { color: var(--purple); font-family: serif; font-size: 32rpx; }
.sold-overlay { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(41,37,31,.24); }.sold-overlay text { padding: 12rpx 24rpx; border-radius: 999rpx; color: white; background: rgba(41,37,31,.7); font-size: 25rpx; }.stock-empty { color: var(--muted); }.image-label { position: absolute; bottom: 10rpx; right: 10rpx; border-radius: 8rpx; padding: 4rpx 8rpx; color: white; background: rgba(41,37,31,.48); font-size: 17rpx; }.price-from { margin-left: 6rpx; font-size: 21rpx; font-weight: 400; }
.state-panel { padding: 90rpx 32rpx; text-align: center; }.state-title { color: var(--purple-dark); font-size: 32rpx; font-weight: 700; }.state-copy { margin: 18rpx 0 32rpx; color: var(--muted); font-size: 25rpx; line-height: 1.7; }.state-panel button { display: inline-block; padding: 0 42rpx; }

.attention-actions { display: flex; gap: 12rpx; margin-top: 18rpx; flex-wrap: wrap; } .attention-actions button { margin: 0; padding: 0 16rpx; font-size: 22rpx; line-height: 2.6; color: var(--purple); background: #eee1f3; border-radius: 14rpx; } .reminder-note { margin-top: 16rpx; font-size: 23rpx; }
.sort-bar { display: flex; justify-content: space-around; padding: 12rpx 0 24rpx; color: var(--muted); } .sort-bar view { padding: 12rpx 22rpx; } .sort-bar .selected { color: var(--purple); font-weight: 700; } .sales { margin-top: 12rpx; font-size: 21rpx; }

.memory-tools { display: flex; gap: 16rpx; margin-bottom: 24rpx; } .memory-tools button { flex: 1; font-size: 24rpx; }
.search-suggestions, .filter-panel, .favorite-searches { padding: 24rpx; margin-bottom: 24rpx; }
.suggestion-heading { display: flex; align-items: center; gap: 14rpx; margin-bottom: 16rpx; color: var(--purple-dark); font-size: 26rpx; }
.suggestion-heading > text:first-child { flex: 1; }
.suggestion-heading button, .active-filters button { margin: 0; padding: 0 12rpx; font-size: 23rpx; color: var(--purple); background: transparent; line-height: 2; }
.search-chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 20rpx; }
.search-chip { display: flex; align-items: center; gap: 8rpx; max-width: 100%; padding: 8rpx 18rpx; margin: 0; border-radius: 18rpx; background: #eee1f3; color: var(--purple); font-size: 24rpx; line-height: 1.8; word-break: break-all; }
.search-chip text { min-width: 0; }
.search-chip button { flex-shrink: 0; margin: 0; padding: 0 10rpx; font-size: 28rpx; color: var(--muted); background: transparent; line-height: 1.8; }
.search-note { font-size: 22rpx; margin-bottom: 16rpx; }
.filter-label { margin: 18rpx 0; font-size: 25rpx; }
.search-chips .filter { margin: 0; font-size: 24rpx; line-height: 1.8; }
.price-inputs { display: flex; align-items: center; gap: 16rpx; }
.price-inputs input { min-width: 0; flex: 1; padding: 18rpx; background: var(--paper); border: 1rpx solid #ddd4c6; border-radius: 12rpx; font-size: 25rpx; }
.filter-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.filter-actions button { flex: 1; font-size: 25rpx; }
.active-filters { display: flex; align-items: center; flex-wrap: wrap; margin-bottom: 22rpx; font-size: 23rpx; color: var(--purple); }
