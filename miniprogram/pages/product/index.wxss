.trace-code-card { margin: 24rpx 0; padding: 24rpx; border-radius: 18rpx; background: #edf2e9; }.trace-code { display: block; color: var(--green); font-size: 28rpx; font-weight: 700; overflow-wrap: anywhere; }.trace-code-card button { margin-top: 18rpx; }.gift-options { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 20rpx 0; }
.gallery { width: 100%; height: 620rpx; background: #ddd; }.gallery image { width: 100%; height: 100%; }
.product-info { background: var(--paper); }.badges { display: flex; flex-wrap: wrap; gap: 12rpx; }.name { margin-top: 22rpx; font-family: serif; font-size: 48rpx; font-weight: 700; }.subtitle { margin-top: 8rpx; color: var(--muted); font-size: 25rpx; }.price-row { display: flex; align-items: baseline; gap: 14rpx; margin-top: 22rpx; }.compare { color: #aaa198; font-size: 23rpx; text-decoration: line-through; }.presale { margin-top: 18rpx; padding: 16rpx; border-radius: 12rpx; color: var(--purple); background: #f0e5f2; font-size: 23rpx; }.origin { margin-top: 18rpx; color: var(--muted); font-size: 23rpx; }
.divider { height: 18rpx; background: var(--cream); }.options, .detail { background: var(--paper); }.option-title { margin-bottom: 22rpx; font-size: 30rpx; font-weight: 700; }.sku { display: flex; justify-content: space-between; align-items: center; margin-top: 15rpx; padding: 22rpx; border: 2rpx solid #e8e1d7; border-radius: 16rpx; }.sku.active { border-color: var(--purple); background: #faf4fb; }.sku text { display: block; }.sku-name { font-weight: 700; }.weight, .stock { margin-top: 8rpx; color: var(--muted); font-size: 21rpx; text-align: right; }
.quantity { display: flex; justify-content: space-between; align-items: center; margin-top: 30rpx; }.quantity view { display: flex; align-items: center; gap: 22rpx; }.quantity button { margin: 0; padding: 0; width: 54rpx; height: 54rpx; background: #eee9e1; line-height: 54rpx; font-size: 28rpx; }
.highlights { display: flex; justify-content: space-between; }.highlights view { width: 31%; padding: 20rpx 8rpx; border-radius: 14rpx; background: #edf2e9; color: var(--green); font-size: 22rpx; text-align: center; }.highlights text { margin-right: 4rpx; }.description { margin-top: 28rpx; color: #514b43; line-height: 1.85; }.notice { margin-top: 32rpx; padding: 24rpx; border-left: 5rpx solid var(--gold); background: #f8f1df; }.notice view { font-weight: 700; }.notice text { display: block; margin-top: 10rpx; color: var(--muted); font-size: 22rpx; line-height: 1.65; }
.bottom-bar { position: fixed; z-index: 9; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 100rpx 1fr 1fr; gap: 12rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #eee7dd; background: rgba(255,253,248,.97); }.bottom-bar button { margin: 0; font-size: 25rpx; }.cart { display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--muted); font-size: 19rpx; }.cart text:first-child { font-size: 26rpx; }

.product-page { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }.gallery-wrap { position: relative; }.image-label { position: absolute; right: 20rpx; bottom: 22rpx; padding: 6rpx 12rpx; border-radius: 8rpx; color: white; background: rgba(41,37,31,.48); font-size: 20rpx; }.image-placeholder { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20rpx; background: #eee8dc; color: var(--muted); font-size: 24rpx; }.image-placeholder text:first-child { font-family: serif; color: var(--purple); font-size: 48rpx; }
.sold-notice { margin-top: 22rpx; padding: 22rpx; border-radius: 14rpx; background: #eee8dc; color: var(--muted); font-size: 25rpx; }.sku-empty { opacity: .5; border-style: dashed; }.quantity button[disabled] { opacity: .4; }.quantity-hint { margin-top: 16rpx; text-align: right; color: var(--muted); font-size: 22rpx; }.bottom-bar .ghost-btn[disabled] { opacity: .4; color: var(--muted); }
.after-sales { margin-top: 36rpx; }.service-item { padding: 20rpx 0; border-top: 1rpx solid #ece5da; }.service-item view { font-size: 26rpx; font-weight: 700; }.service-item text { display: block; margin-top: 12rpx; color: var(--muted); font-size: 23rpx; line-height: 1.8; }.service-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }.service-actions button { flex: 1; padding: 0 12rpx; font-size: 24rpx; }
.state-panel { padding: 120rpx 30rpx; text-align: center; }.state-title { color: var(--purple-dark); font-size: 34rpx; font-weight: 700; }.state-copy { margin: 20rpx 0 36rpx; color: var(--muted); line-height: 1.8; }.state-panel button { margin: 20rpx auto; }

.attention-actions { display: flex; gap: 12rpx; margin-top: 18rpx; flex-wrap: wrap; } .attention-actions button { margin: 0; padding: 0 16rpx; font-size: 22rpx; line-height: 2.6; color: var(--purple); background: #eee1f3; border-radius: 14rpx; } .reminder-note { margin-top: 16rpx; font-size: 23rpx; }
.content-section { background: var(--paper); }.section-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 20rpx; }.section-heading > text, .section-copy { color: var(--muted); font-size: 23rpx; line-height: 1.8; }.content-section > button { margin-top: 24rpx; }.review-item { padding: 26rpx 0; border-bottom: 1rpx solid #ece5da; }.review-stars { color: var(--gold) !important; }.review-copy { margin: 14rpx 0; line-height: 1.8; overflow-wrap: anywhere; white-space: pre-wrap; }.trace-facts { background: #f4f0e7; padding: 24rpx; border-radius: 18rpx; }.trace-facts > view { display: flex; gap: 20rpx; padding: 8rpx 0; font-size: 24rpx; color: var(--muted); }.trace-facts text { flex: 1; color: #514b43; overflow-wrap: anywhere; }.trace-step { display: flex; gap: 20rpx; margin: 24rpx 0; }.step-number { width: 44rpx; height: 44rpx; border-radius: 50%; background: #edf2e9; color: var(--green); text-align: center; line-height: 44rpx; flex-shrink: 0; }.trace-step > view { flex: 1; }.trace-step text:not(.step-number), .pairing-card > text { display: block; color: var(--muted); font-size: 23rpx; line-height: 1.8; margin-top: 8rpx; }.pairing-card { padding: 26rpx; margin-top: 18rpx; border-radius: 18rpx; background: #f7f1e6; }.pairing-card > view { font-weight: 700; }.pairing-card button { margin-top: 18rpx; font-size: 24rpx; }

.review-photos{display:flex;flex-wrap:wrap;gap:12rpx;margin:16rpx 0}.review-photos image{width:160rpx;height:160rpx;border-radius:12rpx}.review-followup,.my-review{margin:18rpx 0;padding:18rpx;background:#f6f2ed;border-radius:12rpx;line-height:1.8}

.target-price-input { padding: 20rpx; margin: 16rpx 0; border: 1rpx solid #ded2e3; border-radius: 12rpx; font-size: 26rpx; }

.related-articles{margin:32rpx 0}.related-article{display:flex;gap:20rpx;align-items:center;padding:20rpx 0;border-top:1rpx solid #e5e1d8}.related-article-cover{width:120rpx;height:120rpx;border-radius:8rpx}.related-article-title{font-size:26rpx;line-height:1.6}