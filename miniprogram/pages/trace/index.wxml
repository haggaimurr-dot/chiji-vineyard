<view class="page-pad">
 <view class="card trace-card"><view class="title">批次溯源查询</view><text>输入或扫描包装上的溯源码，查看果园与批次资料。</text><input value="{{code}}" bindinput="input" maxlength="120" placeholder="请输入溯源码" disabled="{{busy}}"/><button class="primary-btn" bindtap="query" loading="{{busy}}" disabled="{{busy}}">查询批次</button><button class="ghost-btn" bindtap="scan" disabled="{{busy}}">扫描溯源码</button><view class="error" wx:if="{{error}}">{{error}}</view></view>
 <view wx:if="{{result}}" class="card trace-card"><view class="title">{{result.demo?'示例批次资料':'批次资料'}}</view><image wx:if="{{result.cover}}" src="{{result.cover}}" mode="aspectFill" class="trace-cover"/><view wx:if="{{result.productName}}">商品：{{result.productName}}<text wx:if="{{result.variety}}">（{{result.variety}}）</text></view><view>批次号：{{result.number}}</view><view>溯源码：{{result.code}}</view><view>果园 / 地块：{{result.orchard}}</view><view>采收日期：{{result.harvestedAt||'待采收'}}</view><view>包装日期：{{result.packedAt||'待包装'}}</view><view>有效期至：{{result.expiresAt||'未设置'}}</view><view>档案状态：{{result.status==='ARCHIVED'?'已归档':'使用中'}}</view><view wx:if="{{result.externalTrace}}"><view class="title">外部溯源平台</view><view>{{result.externalTrace.platform}}</view><view wx:if="{{result.externalTrace.code}}">平台编码：{{result.externalTrace.code}}</view><text selectable="{{true}}">{{result.externalTrace.url}}</text><button class="ghost-btn" bindtap="copyExternal">复制平台查询链接</button><text>可在浏览器打开链接，资料由外部平台提供。</text></view><text wx:if="{{result.demo}}">演示资料，仅用于体验查询流程。</text></view>
</view>
