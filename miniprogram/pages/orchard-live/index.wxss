page{background:#f8f6f0}.live-page{padding:46rpx 40rpx 70rpx;color:#303c2d}.live-eyebrow{color:#858679;font-size:22rpx;letter-spacing:2rpx}.live-title{margin-top:28rpx;font-family:"Songti SC","SimSun",serif;font-size:44rpx;line-height:1.6}.live-intro{margin-top:14rpx;font-size:25rpx;color:#747868;line-height:1.8}.live-tabs{display:flex;gap:16rpx;margin:40rpx 0 26rpx}.live-tab{flex:1;padding:18rpx 12rpx;background:transparent;color:#7e806e;border:1rpx solid #dcded1;border-radius:6rpx;font-size:26rpx;line-height:1.4}.live-tab.selected{background:#e8ecdf;color:#46563d;border-color:#a5b095}.live-video{display:block;width:100%;height:390rpx;background:#20271f;border-radius:6rpx}.live-placeholder{min-height:390rpx;padding:36rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:24rpx;background:#e9ebe2;border-radius:6rpx;color:#667355;font-size:26rpx;text-align:center}.live-placeholder-title{font-family:"Songti SC","SimSun",serif;font-size:32rpx}.live-placeholder-note{color:#818575;font-size:23rpx;line-height:1.7}.live-button{background:#526844;color:#fffdf8;font-size:24rpx;line-height:2.4;padding:0 30rpx;border-radius:6rpx;margin:0}.live-state{margin-top:15rpx;color:#697659;font-size:22rpx}.live-description{margin-top:32rpx;font-size:27rpx;line-height:1.8}.live-hours{margin-top:20rpx;font-size:24rpx;color:#697659;white-space:pre-line;overflow-wrap:break-word}.live-note{margin-top:24rpx;font-size:22rpx;line-height:1.9;color:#929383}.live-refresh{padding:0;margin:30rpx 0 0;background:transparent;text-align:left;font-size:23rpx;color:#5a684c}
.live-notice{margin-top:24rpx;padding:28rpx;background:#fdf6ec;border:1rpx solid #e8d9bd;border-radius:6rpx;display:flex;flex-direction:column;gap:12rpx}.live-notice-title{font-size:24rpx;color:#a07c3f;letter-spacing:2rpx}.live-notice-text{font-size:28rpx;color:#4a3f2c;line-height:1.7}.live-notice-countdown{font-size:24rpx;color:#b3542e;font-weight:bold}
.replay-section{margin-top:32rpx;padding-top:24rpx;border-top:1px solid #eee}
.replay-title{font-size:32rpx;font-weight:700}
.replay-item{padding:20rpx 0;border-bottom:1px solid #f5f3ee}
.replay-item-title{font-size:28rpx;display:block}

.live-product{display:flex;align-items:center;gap:20rpx;padding:20rpx 0;border-bottom:1px solid #f5f3ee}
.live-product-cover{width:120rpx;height:120rpx;border-radius:12rpx}
.live-product-info{flex:1}
.live-product-name{font-size:28rpx;display:block}
.live-product-price{font-size:28rpx;color:#c65d21;font-weight:700}
.live-product-go{font-size:26rpx;color:#999}
