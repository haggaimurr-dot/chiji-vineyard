.activity-page{padding-top:28rpx;padding-bottom:60rpx}.activity-hero{padding:36rpx;border-radius:28rpx;background:linear-gradient(120deg,#eee3ef,#f5ebd5);margin-bottom:28rpx}.hero-top{display:flex;justify-content:space-between;align-items:center;gap:20rpx}.kicker{color:var(--purple);font-size:22rpx;letter-spacing:3rpx}.activity-title{font-size:42rpx;font-weight:700;color:var(--purple-dark);line-height:1.4;margin-top:28rpx;word-break:break-all}.activity-summary{font-size:27rpx;line-height:1.7;margin-top:18rpx;color:var(--muted)}.activity-date{margin-top:30rpx;color:var(--purple);font-size:24rpx}.time-note,.hint{font-size:23rpx;line-height:1.7;color:var(--muted);margin-top:16rpx}.detail-card{padding:30rpx;margin-bottom:24rpx}.content-paragraph{margin-top:24rpx;font-size:28rpx;line-height:1.9;white-space:pre-wrap;word-break:break-all}.reservation-state{margin-top:24rpx;font-size:28rpx;font-weight:700}.reminder-note{margin-top:18rpx;padding:22rpx;background:#edf2e9;color:var(--green);border-radius:16rpx;font-size:25rpx;line-height:1.7}.reservation-button,.product-button{margin-top:26rpx;background:var(--green);color:white;border-radius:999rpx}.cancel-button,.home-button{background:#eee9df;color:var(--muted)}.feedback{padding:30rpx;text-align:center;color:var(--muted);line-height:1.7}.feedback button{margin-top:22rpx}.home-button{margin-top:32rpx;border-radius:999rpx}
.topic-cover{display:block;width:100%;height:360rpx;border-radius:28rpx;margin-bottom:24rpx}.share-button{margin-top:24rpx;background:#fffaf1;color:var(--purple);border-radius:999rpx}
