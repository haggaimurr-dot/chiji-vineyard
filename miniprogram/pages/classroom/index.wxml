<view class="page">
  <view class="class-hero">
    <view class="eyebrow">GRAPE GROWING NOTES</view>
    <view class="title"><text>种好一串葡萄，</text><text>从理解每个阶段开始</text></view>
    <view class="copy">来自果园的一线记录，免费、实用、持续更新</view>
  </view>
  <view class="page-pad">
    <view class="learning-tabs"><view wx:for="{{views}}" wx:key="value" class="learning-tab {{view === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="pickView">{{item.label}}</view></view>
    <include src="learning.wxml" />
    <block wx:if="{{view === 'all' || view === 'favorite' || view === 'history'}}">
    <view class="search-bar"><input value="{{keyword}}" maxlength="100" placeholder="搜索标题、摘要、阶段或品种" confirm-type="search" bindinput="onSearch" bindconfirm="confirmSearch" /><button wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">清空</button><button class="search-submit" bindtap="confirmSearch">搜索</button></view>
    <view class="learning-note" wx:if="{{view === 'history'}}">成功打开内容后自动记录，按最近阅读排序 · 北京时间</view>
    <scroll-view scroll-x show-scrollbar="false" class="stage-scroll">
      <view class="stages"><view class="stage {{stage === item ? 'active' : ''}}" wx:for="{{stages}}" wx:key="*this" data-value="{{item}}" bindtap="pickStage">{{item}}</view></view>
    </scroll-view>
    <picker mode="selector" range="{{varieties}}" bindchange="onVariety">
      <view class="variety-picker">品种筛选：<text>{{variety}}</text><text>⌄</text></view>
    </picker>
    <view class="articles">
      <view class="article card" wx:for="{{articles}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
        <image class="cover" src="{{item.cover}}" mode="aspectFill" />
        <view class="article-body">
          <view class="meta"><text>{{item.stage}} · {{item.variety}}</text><text wx:if="{{item.type === 'video'}}">▶ {{item.duration}}</text></view>
          <view class="article-title">{{item.title}}</view>
          <view class="summary">{{item.summary}}</view>
          <view class="last-read" wx:if="{{view === 'history' && item.lastReadText}}">最近学习：{{item.lastReadText}}</view>
          <view class="read"><text>阅读全文 →</text><text class="read-count" wx:if="{{item.readCount >= 0}}">阅读 {{item.readCount}}</text></view>
          <button class="favorite-btn {{item.favorite ? 'saved' : ''}}" disabled="{{favoriteBusy || loading || loadingMore}}" data-id="{{item.id}}" catchtap="toggleFavorite">{{item.favorite ? '♥ 已收藏' : '♡ 收藏内容'}}</button>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{loading && !articles.length}}">正在加载课堂内容…</view>
    <view class="empty" wx:elif="{{error}}"><view>{{error}}</view><button class="ghost-btn" bindtap="retry">重试</button></view>
    <view class="empty" wx:elif="{{!articles.length}}">{{keyword || stage !== '全部' || variety !== '全部' ? '没有匹配的内容，试试其他关键词或筛选条件' : view === 'favorite' ? '还没有收藏内容，点击内容卡片上的收藏按钮即可保存' : view === 'history' ? '暂无学习记录，打开一篇课堂内容开始学习吧' : '课堂内容正在准备中'}}</view>
    <view class="empty" wx:if="{{articles.length && (hasMore || loadingMore || moreError)}}"><view wx:if="{{moreError}}">{{moreError}}</view><button class="ghost-btn" disabled="{{loadingMore}}" bindtap="loadMore">{{loadingMore ? '正在加载…' : moreError ? '重试加载' : '加载更多'}}</button></view>
    </block>
  </view>
</view>
