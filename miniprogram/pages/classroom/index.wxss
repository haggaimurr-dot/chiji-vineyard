.class-hero { padding: 64rpx 38rpx; color: white; background: linear-gradient(135deg, #2f513b, #6a3b65); }
.eyebrow { color: #dfc47b; font-size: 19rpx; letter-spacing: 4rpx; }
.title { margin-top: 24rpx; font-family: serif; font-size: 48rpx; font-weight: 700; line-height: 1.4; }
.title text { display: block; }
.copy { margin-top: 18rpx; color: rgba(255,255,255,.7); font-size: 24rpx; }
.stage-scroll { margin: 0 -28rpx; width: auto; }
.stages { display: flex; gap: 14rpx; width: max-content; padding: 4rpx 28rpx 20rpx; }
.stage { padding: 15rpx 26rpx; border-radius: 999rpx; background: #ebe5da; color: var(--muted); font-size: 24rpx; }
.stage.active { color: white; background: var(--purple); }
.variety-picker { display: flex; justify-content: space-between; margin: 6rpx 0 26rpx; padding: 23rpx 26rpx; border-radius: 18rpx; background: rgba(255,255,255,.6); color: var(--muted); font-size: 24rpx; }
.variety-picker text:first-of-type { margin-left: auto; margin-right: 18rpx; color: var(--green); }
.article { overflow: hidden; margin-bottom: 24rpx; }
.cover { width: 100%; height: 320rpx; }
.article-body { padding: 28rpx; }
.meta { display: flex; justify-content: space-between; color: var(--green); font-size: 22rpx; }
.article-title { margin-top: 17rpx; font-size: 34rpx; font-weight: 700; line-height: 1.4; }
.summary { margin-top: 12rpx; color: var(--muted); font-size: 24rpx; line-height: 1.65; }
.read { display: flex; justify-content: space-between; gap: 16rpx; margin-top: 20rpx; color: var(--purple); font-size: 23rpx; }
.read-count { color: var(--muted); }
.empty button { margin-top: 24rpx; }
.search-bar { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 16rpx; margin-bottom: 22rpx; border-radius: 18rpx; background: white; }
.search-bar input { flex: 1; min-width: 0; font-size: 24rpx; }
.search-bar button { margin: 0; padding: 0 14rpx; line-height: 2.5; font-size: 23rpx; }
.search-submit { color: white; background: var(--green); }
.search-clear { color: var(--muted); background: transparent; }
.learning-tabs { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 24rpx; }
.learning-tab { box-sizing: border-box; width: calc((100% - 24rpx) / 3); padding: 22rpx 8rpx; text-align: center; border-radius: 16rpx; color: var(--muted); background: #ebe5da; font-size: 25rpx; }
.learning-tab.active { color: white; background: var(--green); }
.learning-note, .last-read { color: var(--muted); font-size: 22rpx; line-height: 1.6; margin-bottom: 20rpx; }
.last-read { margin-top: 18rpx; margin-bottom: 0; }
.favorite-btn { margin: 20rpx 0 0; padding: 0 20rpx; text-align: center; color: var(--purple); background: #f2edf2; font-size: 24rpx; line-height: 2.6; border-radius: 14rpx; }
.favorite-btn.saved { color: var(--green); background: var(--green-soft); }
.course-summary, .course-card, .question-card { padding: 28rpx; margin-bottom: 24rpx; }
.course-heading { font-size: 32rpx; font-weight: 700; margin-bottom: 16rpx; }
.course-meta { font-size: 22rpx; color: var(--muted); margin-bottom: 16rpx; line-height: 1.6; }
.course-note { font-size: 23rpx; color: var(--muted); line-height: 1.7; margin: 20rpx 0; }
.course-actions { display: flex; gap: 16rpx; margin-top: 24rpx; align-items: center; }
.course-actions button { flex: 1; margin: 0; padding: 0 16rpx; font-size: 24rpx; }
.course-done { flex: 1; color: var(--green); font-size: 25rpx; }
.lesson-row { display: flex; gap: 16rpx; align-items: center; padding: 24rpx 0; border-top: 1rpx solid #ebe5da; font-size: 24rpx; }
.course-lessons { margin-top: 24rpx; }
.lesson-index { color: var(--muted); }
.lesson-title { flex: 1; }
.lesson-status { color: var(--green); white-space: nowrap; font-size: 21rpx; }
.question-text, .question-answer { font-size: 26rpx; line-height: 1.7; white-space: pre-wrap; word-break: break-all; }
.question-answer { padding: 20rpx; background: var(--green-soft); border-radius: 12rpx; margin: 20rpx 0; }
