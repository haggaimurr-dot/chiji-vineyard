<view class="page page-pad"><view wx:if="{{loading}}">正在加载隐私政策…</view><view wx:elif="{{error}}" class="card policy"><text>{{error}}</text><button class="ghost-btn" bindtap="load">重试</button></view><view wx:elif="{{policy}}" class="card policy"><view class="demo" wx:if="{{demo}}">演示政策预览，主体信息为演示内容</view><view class="title">{{policy.title}}</view><view class="meta">版本 {{policy.version}} · 生效日期 {{policy.effectiveDate}}</view><view class="identity">运营主体：{{policy.operator}}
联系地址：{{policy.address}}
隐私联系方式：{{policy.contact}}</view><button class="ghost-btn" bindtap="copyContact">复制隐私联系方式</button><text class="paragraph" wx:for="{{policy.content}}" wx:key="index">{{item}}</text></view></view>