.hero { position: relative; overflow: hidden; margin: 22rpx 22rpx 0; padding: 62rpx 44rpx 54rpx; min-height: 520rpx; border-radius: 38rpx; color: white; background: linear-gradient(145deg, #244932 0%, #4f6f45 50%, #7c426d 130%); }
.hero-image-note{position:absolute;right:24rpx;bottom:20rpx;padding:6rpx 12rpx;border-radius:8rpx;background:rgba(0,0,0,.45);font-size:20rpx;z-index:2}
.image-placeholder{display:flex;align-items:center;justify-content:center;color:var(--muted);background:#e7e0d6;font-size:23rpx}
.image-note{color:var(--muted);font-size:20rpx;margin-bottom:10rpx}
.hero-kicker { font-size: 20rpx; letter-spacing: 5rpx; opacity: .72; }
.hero-title { position: relative; z-index: 2; margin-top: 28rpx; width: 520rpx; font-family: serif; font-size: 56rpx; font-weight: 700; line-height: 1.35; }
.hero-title text { display: block; }
.hero-copy { position: relative; z-index: 2; margin-top: 22rpx; font-size: 25rpx; opacity: .84; }
.hero-btn { position: relative; z-index: 2; margin: 42rpx 0 0; width: 250rpx; color: #3d2445; background: #f4e4b7; font-size: 26rpx; border-radius: 999rpx; }
.grape { position: absolute; border-radius: 50%; background: rgba(235, 211, 242, .18); box-shadow: inset 0 -18rpx 40rpx rgba(54,21,64,.25); }
.grape-one { width: 180rpx; height: 180rpx; right: -20rpx; top: 50rpx; }
.grape-two { width: 140rpx; height: 140rpx; right: 90rpx; top: 190rpx; }
.grape-three { width: 210rpx; height: 210rpx; right: -60rpx; bottom: -50rpx; }
.promise-strip { margin: 0 42rpx; padding: 24rpx 0; display: flex; justify-content: space-between; color: #496552; font-size: 23rpx; }
.promise-strip view { display: flex; align-items: center; gap: 8rpx; }
.promise-icon { display: inline-flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; border: 1rpx solid #9ab09c; border-radius: 50%; font-size: 19rpx; }
.product-scroll { margin: 0 -28rpx; width: auto; }
.product-row { display: flex; gap: 22rpx; padding: 0 28rpx 18rpx; width: max-content; }
.product-card { overflow: hidden; width: 410rpx; }
.product-image { width: 100%; height: 285rpx; background: #ded9c9; }
.product-body { padding: 24rpx; }
.product-badges { height: 42rpx; }
.product-name { margin-top: 10rpx; font-size: 34rpx; font-weight: 700; }
.product-subtitle { margin-top: 7rpx; color: var(--muted); font-size: 23rpx; }
.product-body .price { margin-top: 20rpx; }
.from { color: var(--muted); font-size: 20rpx; font-weight: 400; }
.story-card { padding: 42rpx; color: white; background: linear-gradient(135deg, #5d2d6b, #35143f); }
.story-label { color: #d9b968; font-size: 19rpx; letter-spacing: 4rpx; }
.story-title { margin-top: 22rpx; font-family: serif; font-size: 43rpx; font-weight: 700; }
.story-copy { margin-top: 18rpx; width: 90%; color: rgba(255,255,255,.75); font-size: 25rpx; line-height: 1.75; }
.story-btn { margin: 28rpx 0 0; width: 210rpx; border: 1rpx solid rgba(255,255,255,.4); color: white; background: transparent; font-size: 24rpx; border-radius: 999rpx; }
.article { display: flex; overflow: hidden; margin-bottom: 20rpx; }
.article-cover { flex: none; width: 220rpx; height: 200rpx; }
.article-info { padding: 24rpx; min-width: 0; }
.article-meta { color: var(--green); font-size: 21rpx; }
.article-title { margin-top: 12rpx; font-size: 29rpx; font-weight: 700; line-height: 1.35; }
.article-summary { margin-top: 10rpx; color: var(--muted); font-size: 22rpx; line-height: 1.5; display: -webkit-box; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.cooperation-card { display: flex; align-items: center; justify-content: space-between; padding: 34rpx; border-radius: 26rpx; background: #dfe9d9; color: #294333; }
.cooperation-title { font-size: 31rpx; font-weight: 700; }
.cooperation-copy { margin-top: 8rpx; color: #627866; font-size: 23rpx; }
.cooperation-arrow { font-size: 46rpx; }
.home-feedback { padding: 24rpx; color: var(--purple); }
.home-feedback button { margin-top: 16rpx; }
.home-loading, .home-empty { padding: 28rpx; color: var(--muted); font-size: 25rpx; text-align: center; }
.notice-board { padding: 26rpx 30rpx; }
.notice-heading { color: var(--purple-dark); font-weight: 700; font-size: 29rpx; }
.notice-caption { margin-left: 18rpx; color: var(--muted); font-weight: 400; font-size: 22rpx; }
.notice-row { display: flex; align-items: center; gap: 20rpx; padding-top: 22rpx; margin-top: 18rpx; border-top: 1rpx solid #eee7dc; }
.notice-info { flex: 1; min-width: 0; }
.notice-title { font-size: 26rpx; line-height: 1.5; }
.notice-date { font-size: 21rpx; color: var(--muted); }
.notice-arrow { font-size: 38rpx; color: var(--purple); }
.activity-card { margin-bottom: 20rpx; padding: 32rpx; border-radius: 28rpx; background: linear-gradient(120deg, #eee3ef, #f5ebd5); }
.activity-top, .activity-footer, .calendar-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.activity-kicker { color: var(--purple); font-size: 22rpx; letter-spacing: 3rpx; }
.activity-status { padding: 7rpx 14rpx; background: rgba(255,255,255,.65); border-radius: 999rpx; font-size: 22rpx; color: var(--purple); }
.activity-title { margin-top: 20rpx; font-size: 35rpx; font-weight: 700; color: var(--purple-dark); }
.activity-summary { margin-top: 12rpx; font-size: 25rpx; color: var(--muted); line-height: 1.6; }
.activity-footer { flex-wrap: wrap; margin-top: 30rpx; color: var(--purple); font-size: 22rpx; }
.month-scroll { margin-bottom: 22rpx; }
.month-row { display: flex; gap: 12rpx; width: max-content; }
.month-chip { flex: none; padding: 14rpx 24rpx; border-radius: 999rpx; background: #eee9df; color: var(--muted); font-size: 24rpx; }
.month-active { color: white; background: var(--green); }
.calendar-card { padding: 0 30rpx; }
.calendar-row { display: flex; gap: 20rpx; padding: 28rpx 0; border-bottom: 1rpx solid #eee7dc; }
.calendar-row:last-child { border-bottom: 0; }
.calendar-dot { flex: none; width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--green); margin-top: 12rpx; }
.calendar-info { flex: 1; min-width: 0; }
.calendar-heading { flex-wrap: wrap; }
.calendar-variety { font-size: 30rpx; font-weight: 700; }
.calendar-date { margin-top: 14rpx; color: var(--green); font-size: 23rpx; }
.calendar-note, .calendar-hint { margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }
.calendar-link { display: inline-block; margin-top: 18rpx; color: var(--purple); font-size: 24rpx; }
.feature-hint { margin: 14rpx 0; color: var(--muted); font-size: 22rpx; line-height: 1.6; }
.reservation-card { padding: 28rpx; margin-bottom: 20rpx; }
.reservation-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.reservation-title { flex: 1; font-weight: 700; font-size: 29rpx; line-height: 1.5; }
.reservation-heading .pill { flex: none; }
.reservation-copy { margin-top: 12rpx; color: var(--muted); font-size: 23rpx; line-height: 1.6; }
.reservation-date { margin-top: 18rpx; color: var(--green); font-size: 22rpx; }
.reservation-button { margin: 24rpx 0 0; border-radius: 999rpx; background: var(--green); color: white; }
.reservation-cancel { background: #eee9df; color: var(--muted); }
.personalization-control { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; color: var(--muted); font-size: 24rpx; }
.preference-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 24rpx; }
.recommendation-card { display: flex; overflow: hidden; margin-bottom: 20rpx; }
.recommendation-image { flex: none; width: 210rpx; height: 250rpx; }
.recommendation-info { padding: 22rpx; flex: 1; min-width: 0; }
.recommendation-reason { color: var(--green); font-size: 21rpx; }
.recommendation-name { margin-top: 12rpx; font-size: 29rpx; font-weight: 700; }
.recommendation-info .price { margin-top: 16rpx; }

.hero-swiper{height:510rpx}.hero-swiper .hero{height:100%;box-sizing:border-box}.hero-background{position:absolute;inset:0;width:100%;height:100%;opacity:.3}.hero-content{position:relative;z-index:1}

.hero-swiper{height:560rpx;margin:22rpx 22rpx 0}.hero-swiper .hero{margin:0;min-height:0;padding:46rpx 38rpx}.hero-swiper .hero-title{width:auto;font-size:48rpx;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.hero-swiper .hero-copy{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.hero-swiper .hero-btn{margin-top:30rpx}

.activity-reminders { padding: 28rpx; margin-bottom: 28rpx; background: #edf2e9; }
.reminder-row { display:flex; align-items:center; gap:20rpx; padding:22rpx 0; border-bottom:1rpx solid #dce4d7; }
.reminder-info { flex:1; min-width:0; }
.reminder-label { color:var(--green); font-size:23rpx; margin-bottom:8rpx; font-weight:700; }

/* A quiet orchard introduction; operational modules open only on request. */
page { background: #f8f6f0; }
.orchard-home { background: #f8f6f0; color: #303c2d; padding: 0 40rpx 50rpx; }
.orchard-masthead { display: flex; align-items: center; justify-content: space-between; padding: 36rpx 0 28rpx; }
.orchard-name { font-family: "Songti SC", "SimSun", serif; font-size: 29rpx; letter-spacing: 3rpx; }
.orchard-note { color: #828477; font-size: 20rpx; letter-spacing: 2rpx; }
.orchard-photo-frame { overflow: hidden; border-radius: 6rpx; background: #e5e7dc; }
.orchard-photo { display: block; width: 100%; height: 650rpx; }
.orchard-photo-empty { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 20rpx; color: #59634f; font-family: "Songti SC", "SimSun", serif; font-size: 30rpx; background: #e8e9df; }
.orchard-photo-empty-note { color: #828477; font-family: sans-serif; font-size: 22rpx; }
.orchard-photo-caption { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10rpx; padding-top: 16rpx; color: #858679; font-size: 19rpx; letter-spacing: 1rpx; }
.orchard-intro { padding: 52rpx 0 46rpx; }
.orchard-title { font-family: "Songti SC", "SimSun", serif; font-size: 43rpx; font-weight: 500; line-height: 1.6; letter-spacing: 2rpx; }
.orchard-copy { margin-top: 20rpx; color: #747868; font-size: 25rpx; line-height: 1.95; white-space: pre-line; }
.orchard-signature { display: flex; align-items: center; gap: 15rpx; margin-top: 28rpx; color: #858679; font-size: 20rpx; letter-spacing: 1rpx; }
.orchard-rule { width: 28rpx; height: 1rpx; background: #a0a38d; }
.orchard-entrances { border-top: 1rpx solid #dcded1; }
.orchard-entrance { display: flex; align-items: center; gap: 24rpx; padding: 29rpx 0; border-bottom: 1rpx solid #dcded1; }
.orchard-entrance-number { align-self: flex-start; padding-top: 5rpx; color: #959882; font-size: 20rpx; font-family: Georgia, serif; }
.orchard-entrance-copy { flex: 1; min-width: 0; }
.orchard-entrance-title { font-family: "Songti SC", "SimSun", serif; font-size: 31rpx; line-height: 1.5; }
.orchard-entrance-description { margin-top: 5rpx; color: #818575; font-size: 22rpx; line-height: 1.6; }
.orchard-entrance-arrow { color: #667355; font-size: 32rpx; padding: 0 6rpx; }
.orchard-entrance-hover { background: #efeee5; }
.orchard-feedback { display: flex; align-items: center; flex-wrap: wrap; gap: 18rpx; margin-bottom: 24rpx; color: #7e806e; font-size: 23rpx; line-height: 1.6; }
.orchard-retry { margin: 0; padding: 0 18rpx; color: #536346; background: #e9ebdf; }
.orchard-more { padding: 36rpx 0 0; }
.orchard-more-button { display: flex; align-items: center; justify-content: space-between; width: 100%; margin: 0; padding: 0; border-radius: 0; text-align: left; color: #5a684c; background: transparent; font-size: 25rpx; font-weight: 400; line-height: 2; }
.orchard-more-symbol { font-size: 31rpx; color: #7b846a; }
.orchard-more-note { display: block; margin-top: 5rpx; color: #929383; font-size: 20rpx; line-height: 1.7; }
.orchard-footer { margin-top: 60rpx; text-align: center; color: #929383; font-size: 20rpx; letter-spacing: 2rpx; }
.home-details { margin: 30rpx -40rpx 0; border-top: 1rpx solid #dcded1; padding-top: 24rpx; }
.home-details .section-title, .home-details .notice-heading { color: #46563d; }
.home-details .link, .home-details .calendar-link, .home-details .price { color: #526844; }
