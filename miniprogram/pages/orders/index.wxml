<view class="page">
  <view class="search-bar"><input placeholder="搜索订单号、商品名称或规格" value="{{keyword}}" bindinput="input" bindconfirm="search" confirm-type="search" maxlength="80"/><button size="mini" bindtap="search">搜索</button><button size="mini" wx:if="{{keyword}}" bindtap="clearSearch">清空</button></view>
  <scroll-view scroll-x class="tabs" show-scrollbar="false"><view class="tab-row"><view class="tab {{filter === item.key ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="tab">{{item.label}}</view></view></scroll-view>
  <view class="page-pad">
    <view class="search-summary" wx:if="{{!loading && !error && orders.length}}">{{queryKeyword ? '“' + queryKeyword + '” · ' : ''}}共 {{total}} 笔订单</view>
    <view class="order card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="order-head"><text>{{item.orderNo}}</text><text>{{item.statusText}}</text></view><view class="order-main"><image src="{{item.firstCover}}" mode="aspectFill"/><view><view>{{item.firstName}}</view><text>共 {{item.count}} 件商品</text></view><view class="amount">¥{{item.totalText}}</view></view><view class="state-tags"><text>订单 · {{item.orderStateText}}</text><text>付款 · {{item.paymentStateText}}</text><text>配送 · {{item.fulfillmentStateText}}</text><text>售后 · {{item.refundStateText}}</text></view><view class="order-foot"><text>{{item.createdAt}}</text><button size="mini" wx:if="{{item.reviewPending}}" data-id="{{item.id}}" catchtap="goReview">去评价</button><button size="mini" class="ghost-btn" data-id="{{item.id}}" catchtap="rebuy" loading="{{rebuyId === item.id}}" disabled="{{!!rebuyId}}">再次购买</button></view></view>
    <view class="empty" wx:if="{{loading}}">正在加载订单…</view>
    <view class="empty" wx:elif="{{error}}"><view>{{error}}</view><button class="ghost-btn" bindtap="retry">{{failedMore ? '重试加载更多' : '重试'}}</button></view>
    <view class="empty" wx:elif="{{!orders.length}}"><view>{{queryKeyword ? '没有找到匹配的订单' : '这里还没有相关订单'}}</view><button wx:if="{{queryKeyword}}" class="ghost-btn" bindtap="clearSearch">清空搜索</button><button wx:else class="ghost-btn" bindtap="goShop">去选葡萄</button></view>
    <view class="empty" wx:elif="{{hasMore}}"><view>已显示 {{orders.length}} / {{total}} 笔订单</view><button class="ghost-btn" bindtap="loadMore">加载更多</button></view>
    <view class="empty" wx:else>已显示全部 {{total}} 笔订单</view>
  </view>
</view>

