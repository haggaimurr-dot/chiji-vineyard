.tabs { position: sticky; z-index: 2; top: 0; background: var(--paper); }.tab-row { display: flex; width: max-content; min-width: 100%; justify-content: space-around; }.tab { position: relative; padding: 25rpx 24rpx; color: var(--muted); font-size: 24rpx; }.tab.active { color: var(--purple); font-weight: 700; }.tab.active::after { position: absolute; left: 25%; right: 25%; bottom: 5rpx; height: 5rpx; border-radius: 5rpx; background: var(--purple); content: ''; }.order { margin-bottom: 22rpx; padding: 26rpx; }.order-head { display: flex; justify-content: space-between; padding-bottom: 20rpx; border-bottom: 1rpx solid #eee8de; color: var(--muted); font-size: 21rpx; }.order-head text:last-child { color: var(--purple); font-weight: 700; }.order-main { display: grid; grid-template-columns: 110rpx 1fr auto; align-items: center; gap: 18rpx; padding: 22rpx 0; }.order-main image { width: 110rpx; height: 105rpx; border-radius: 13rpx; }.order-main view > view { font-weight: 700; }.order-main view > text { display: block; margin-top: 9rpx; color: var(--muted); font-size: 21rpx; }.amount { font-weight: 700; }.order-foot { color: var(--muted); font-size: 20rpx; text-align: right; }.empty button { margin-top: 28rpx; width: 240rpx; }

.search-bar{display:flex;align-items:center;gap:12rpx;padding:24rpx 28rpx;background:var(--paper)}.search-bar input{flex:1;min-width:0;padding:18rpx;background:#efe9df;border-radius:12rpx;font-size:24rpx}.search-bar button{margin:0;font-size:23rpx}.order-foot{display:flex;justify-content:space-between;align-items:center;gap:12rpx}.order-foot button{margin:0;font-size:23rpx}
.search-summary{margin-bottom:20rpx;color:var(--muted);font-size:23rpx}.state-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-bottom:20rpx}.state-tags text{padding:7rpx 12rpx;border-radius:8rpx;background:#f4f0e7;color:var(--muted);font-size:20rpx}
