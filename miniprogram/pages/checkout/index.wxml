<view class="page page-pad safe-bottom">
  <view class="address card" bindtap="address" wx:if="{{address}}"><view class="pin">址</view><view class="address-info"><view><text>{{address.name}}</text><text>{{address.phone}}</text></view><text>{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</text></view><text class="arrow">›</text></view>
  <view class="address card empty-address" bindtap="address" wx:else><view class="pin">＋</view><view>添加收货地址</view><text class="arrow">›</text></view>
  <button wx:if="{{quoteError && !items.length}}" bindtap="onLoad">重新加载结算</button><view class="goods card"><view class="card-title">商品清单</view><view class="good" wx:for="{{items}}" wx:key="skuId"><image src="{{item.product.cover}}" mode="aspectFill"/><view><view class="good-name">{{item.product.name}}</view><view class="spec">{{item.sku.name}} · {{item.sku.weightLabel}}</view><view class="pre" wx:if="{{item.product.saleMode === 'presale'}}">预计 {{item.product.expectedShipDate}} 起发货</view></view><view class="good-right"><text>¥{{item.lineText}}</text><text>×{{item.quantity}}</text></view></view></view>
  <view class="options card"><view class="card-title">优惠券</view>
    <view class="hint">{{autoCoupon ? '自动匹配最优券' : '手动选择'}} · {{couponCode ? couponCode : '未使用优惠券'}}</view>
    <view class="coupon-row"><button size="mini" bindtap="wallet" disabled="{{quoteBusy || redeemBusy || submitting}}">从券包选择</button><button size="mini" bindtap="matchCoupon" disabled="{{redeemBusy || submitting}}">自动选最优</button><button size="mini" bindtap="clearCoupon" disabled="{{redeemBusy || submitting}}">不使用</button></view>
    <view class="coupon-row"><input placeholder="输入优惠券兑换码" maxlength="40" value="{{couponInput}}" bindinput="couponInput" disabled="{{redeemBusy || submitting}}"/><button size="mini" bindtap="useCoupon" loading="{{redeemBusy}}" disabled="{{quoteBusy || redeemBusy || submitting || !couponInput}}">兑换并使用</button></view>
    <text class="hint" wx:if="{{autoCoupon && quote && !couponCode && !quoteBusy}}">券包中暂无适用于本单的券，可兑换或选择其他券。</text><text class="hint">按实际抵扣金额选最优券，相同时优先使用即将到期的券。券不抵运费。</text><text class="hint" wx:if="{{demo}}">演示券 DEMO10：满99减10；DEMO20：满199减20</text><text class="error" wx:if="{{quoteError}}">{{quoteError}}</text><button size="mini" wx:if="{{quoteError}}" bindtap="refreshQuote" disabled="{{quoteBusy || redeemBusy || submitting}}">重试报价</button><text class="hint" wx:if="{{quoteBusy}}">正在计算金额…</text>
  </view>
  <view class="options card"><view class="card-title">配送日期</view><picker mode="date" start="{{deliveryMin}}" end="{{deliveryMax}}" value="{{deliveryDate || deliveryMin}}" bindchange="delivery" disabled="{{submitting}}"><view class="date-choice">{{deliveryDate || '尽快配送（点击选择期望日期）'}} ›</view></picker><button size="mini" wx:if="{{deliveryDate}}" bindtap="clearDelivery" disabled="{{submitting}}">恢复尽快配送</button><text class="hint">期望送达日期，以商家安排及物流时效为准；预售不早于预计发货日期。</text></view>
  <view class="fees card" wx:if="{{quote}}"><view><text>商品金额</text><text>¥{{quote.subtotalText}}</text></view><view><text>运费</text><text>{{quote.freight ? '¥' + quote.freightText : '包邮'}}</text></view><text class="hint" wx:if="{{quote.shippingRuleName}}">配送规则：{{quote.shippingRuleName}}（运费含地区附加费）</text><view class="blocked" wx:if="{{quote.blockedReason}}">{{quote.blockedReason}}</view><view wx:if="{{quote.discount}}"><text>优惠券抵扣</text><text>−¥{{quote.discountText}}</text></view><view class="fee-total"><text>合计</text><text>¥{{quote.totalText}}</text></view></view>
  <view class="note card"><text>订单备注</text><input maxlength="100" placeholder="选填，给果园留言" value="{{note}}" bindinput="note" disabled="{{submitting}}" /></view>
  <view class="agree" bindtap="agree"><text class="check {{agreed ? 'checked' : ''}}">{{agreed ? '✓' : ''}}</text><text>我已阅读购买须知和<text class="link" catchtap="privacy">《隐私政策》</text>，知晓生鲜商品签收与售后规则</text></view>
  <view class="bottom"><view><text>应付</text><text>¥{{quote.totalText || '0.00'}}</text></view><button class="primary-btn" loading="{{submitting}}" disabled="{{submitting || redeemBusy || quoteBusy || !quote || quoteError || quote.blockedReason}}" bindtap="submit">微信支付</button></view>
</view>

