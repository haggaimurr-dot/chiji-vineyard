.address { display: grid; grid-template-columns: 64rpx 1fr 30rpx; align-items: center; gap: 16rpx; padding: 28rpx; border-bottom: 5rpx solid transparent; background-image: linear-gradient(var(--paper),var(--paper)), repeating-linear-gradient(90deg,#6c8b70 0,#6c8b70 30rpx,#faf2e0 30rpx,#faf2e0 50rpx,#7e4e7c 50rpx,#7e4e7c 80rpx,#faf2e0 80rpx,#faf2e0 100rpx); background-origin: border-box; background-clip: padding-box,border-box; }.pin { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 50%; color: white; background: var(--green); }.address-info view { display: flex; gap: 16rpx; font-weight: 700; }.address-info > text { display: block; margin-top: 10rpx; color: var(--muted); font-size: 23rpx; line-height: 1.45; }.arrow { color: #aaa; font-size: 40rpx; }.empty-address { min-height: 130rpx; }.goods,.fees,.note { margin-top: 22rpx; padding: 28rpx; }.card-title { font-size: 29rpx; font-weight: 700; }.good { display: grid; grid-template-columns: 130rpx 1fr auto; gap: 18rpx; margin-top: 24rpx; }.good image { width: 130rpx; height: 125rpx; border-radius: 14rpx; }.good-name { font-weight: 700; }.spec,.pre { margin-top: 8rpx; color: var(--muted); font-size: 20rpx; }.pre { color: var(--purple); }.good-right { display: flex; flex-direction: column; align-items: flex-end; gap: 12rpx; font-size: 22rpx; }.fees > view { display: flex; justify-content: space-between; margin: 17rpx 0; color: var(--muted); font-size: 24rpx; }.fees .blocked { padding: 15rpx; border-radius: 10rpx; color: #a54252; background: #f8e6e5; }.fees .fee-total { padding-top: 18rpx; border-top: 1rpx solid #eee6da; color: var(--ink); font-weight: 700; }.fee-total text:last-child { color: var(--purple); font-size: 32rpx; }.note { display: flex; align-items: center; gap: 20rpx; }.note text { flex: none; font-weight: 700; }.note input { flex: 1; font-size: 24rpx; }.agree { display: flex; align-items: flex-start; gap: 12rpx; margin: 26rpx 8rpx 140rpx; color: var(--muted); font-size: 21rpx; line-height: 1.5; }.check { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 30rpx; height: 30rpx; border: 2rpx solid #b9b0a2; border-radius: 50%; color: white; }.check.checked { border-color: var(--purple); background: var(--purple); }.bottom { position: fixed; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 1fr 260rpx; align-items: center; gap: 20rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: var(--paper); box-shadow: 0 -8rpx 30rpx rgba(0,0,0,.06); }.bottom view { text-align: right; }.bottom view text:first-child { color: var(--muted); font-size: 22rpx; }.bottom view text:last-child { margin-left: 10rpx; color: var(--purple); font-size: 36rpx; font-weight: 800; }.bottom button { margin: 0; }


.options {margin-top:22rpx;padding:28rpx}.coupon-row {display:flex;gap:12rpx;align-items:center;margin:20rpx 0}.coupon-row input {flex:1;min-width:0;font-size:24rpx}.coupon-row button{flex:none;margin:0}.hint,.error{display:block;font-size:22rpx;line-height:1.6;margin-top:12rpx;color:var(--muted)}.error{color:#a54252}.date-choice{padding:24rpx 0;color:var(--purple)}
