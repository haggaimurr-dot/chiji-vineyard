.card{margin-bottom:24rpx}.title{font-size:32rpx;font-weight:600;margin-bottom:16rpx}.hint{display:block;color:#756f68;font-size:25rpx;line-height:1.7;margin:12rpx 0;word-break:break-all}.actions{display:flex;align-items:center;gap:16rpx;margin-top:20rpx}.actions button{flex:1;font-size:26rpx}.error{color:#b3423f;padding:20rpx}.ticket{width:100%;text-align:left;padding:24rpx;font-size:28rpx;line-height:1.8;white-space:normal;word-break:break-all}.ticket::after{border:0}textarea{width:100%;box-sizing:border-box;min-height:180rpx;background:#f7f3ea;border-radius:12rpx;padding:20rpx;margin:20rpx 0;font-size:28rpx}.category{padding:20rpx;background:#f7f3ea;border-radius:12rpx}.entry{padding:16rpx 0;border-bottom:1rpx solid #eee}.content{white-space:pre-wrap;word-break:break-all;font-size:28rpx}

.return-box { margin-bottom:32rpx; padding:24rpx; border:1rpx solid #e5dfeb; border-radius:16rpx; }
.return-box input { margin:12rpx 0 20rpx; padding:16rpx; background:#f7f5fa; border-radius:12rpx; }
