<view class="page page-pad safe-bottom">
 <view class="card page-pad"><view class="title">售后工单</view><text class="hint">向商家说明品质、物流或发票问题，查看处理进度。默认48小时处理，回复与超时提醒每30秒更新。退款金额及审批结果请到退款页面查看。{{demo ? '演示工单仅保存在本机。' : ''}}</text><view class="actions"><button class="ghost-btn" bindtap="load" disabled="{{loading || busy}}">刷新进度</button><button class="primary-btn" bindtap="startCreate" disabled="{{loading || busy}}">新建工单</button></view></view>
 <view wx:if="{{error}}" class="error" role="alert">{{error}}</view><view wx:if="{{loading}}" class="hint">正在加载工单…</view><view wx:elif="{{!tickets.length}}" class="hint">暂无售后工单</view>
 <view wx:if="{{creating}}" class="card page-pad"><view class="title">新建工单</view><picker range="{{categoryLabels}}" value="{{categoryIndex}}" bindchange="chooseCategory" disabled="{{busy}}"><view class="category">问题类型：{{categoryLabels[categoryIndex]}} ›</view></picker><view class="hint">图片附件：最多3张JPEG/PNG，合计512KB</view><button class="ghost-btn" bindtap="attach" disabled="{{busy}}">添加工单附件</button><view wx:for="{{attachments}}" wx:key="index">{{item.name}}<button class="ghost-btn" data-index="{{index}}" bindtap="removeAttachment" disabled="{{busy}}">移除</button></view><textarea value="{{content}}" bindinput="setContent" maxlength="1000" placeholder="描述问题及希望如何处理（最多1000字）" disabled="{{busy}}"/><button class="primary-btn" bindtap="create" loading="{{busy}}" disabled="{{busy}}">提交工单</button></view>
 <button wx:for="{{tickets}}" wx:key="id" class="card ticket" data-id="{{item.id}}" bindtap="select" disabled="{{busy}}"><view>{{item.categoryText}} · {{item.statusText}}</view><text class="hint">{{item.id}}</text><view>{{item.messages[0].content}}</view><view class="hint">处理期限：{{item.dueAt}}</view><view class="reminder">{{item.reminderText}}</view></button>
 <view class="actions"><button class="ghost-btn" bindtap="previous" disabled="{{!offset || loading || busy}}">上一页</button><text>第 {{offset / 50 + 1}} 页</text><button class="ghost-btn" bindtap="next" disabled="{{!hasMore || loading || busy}}">下一页</button></view>
 <view wx:if="{{selected}}" class="card page-pad"><view wx:if="{{selected.return}}" class="return-box">
 <view class="title">退货进度：{{returnStatuses[selected.return.status]}}</view>
 <view>收件人：{{selected.return.address.name}} · {{selected.return.address.phone}}</view>
 <view class="content">退货地址：{{selected.return.address.province}}{{selected.return.address.city}}{{selected.return.address.district}} {{selected.return.address.detail}}</view>
 <button class="ghost-btn" bindtap="copyReturnAddress">复制退货地址</button>
 <view wx:for="{{selected.return.items}}" wx:key="skuId">{{item.name || item.skuId}} · 退回 {{item.quantity}} 件<text wx:if="{{selected.return.status === 'RECEIVED'}}"> · 可售入库 {{item.restock}} 件 · 隔离 {{item.quantity-item.restock}} 件</text></view>
 <view wx:if="{{selected.return.shipment}}">寄件：{{selected.return.shipment.carrier}} · {{selected.return.shipment.trackingNo}}
  <view class="actions"><button class="ghost-btn" bindtap="copyReturnTracking">复制运单号</button><button class="ghost-btn" bindtap="traceReturn" disabled="{{busy}}">查询退货物流</button></view>
 </view>
 <view wx:if="{{returnTracking}}" class="hint">{{returnTracking.message}}<view wx:for="{{returnTracking.events}}" wx:key="index">{{item.time}} · {{item.context}}</view></view>
 <view wx:if="{{selected.status !== 'CLOSED' && selected.return.status !== 'RECEIVED'}}">
  <view class="hint">请寄往商家确认的退货地址，再登记物流公司和运单号。验收前可更正运单。</view>
  <view>物流公司<input value="{{carrier}}" data-field="carrier" bindinput="setReturnField" maxlength="40" placeholder="例如：顺丰速运" disabled="{{busy}}"/></view>
  <view>承运商编码<input value="{{carrierCode}}" data-field="carrierCode" bindinput="setReturnField" maxlength="20" placeholder="SF / YTO / ZTO / STO / YD / EMS / JD / JT" disabled="{{busy}}"/></view>
  <view>寄件运单号<input value="{{trackingNo}}" data-field="trackingNo" bindinput="setReturnField" maxlength="50" placeholder="请输入寄回包裹运单号" disabled="{{busy}}"/></view>
  <button class="primary-btn" bindtap="shipReturn" disabled="{{busy}}" loading="{{busy}}">登记 / 更正寄件</button>
 </view>
 <view wx:if="{{selected.return.status === 'RECEIVED'}}">验收时间：{{selected.return.receivedAt}}<view>验收结果：{{selected.return.inspection}}</view><text class="hint">退款金额及到账状态请到退款页面查看。</text></view>
</view><view class="title">处理记录</view><view wx:for="{{selected.messages}}" wx:for-index="messageIndex" wx:key="index" class="entry"><text class="hint">{{item.role === 'USER' ? '我' : '商家'}} · {{item.createdAt}}</text><view class="content">{{item.content}}</view><button wx:for="{{item.attachments}}" wx:for-item="file" wx:key="name" class="ghost-btn" data-message="{{messageIndex}}" data-index="{{index}}" bindtap="preview">查看附件：{{file.name}}</button></view><view wx:if="{{selected.status !== 'CLOSED'}}"><text wx:if="{{selected.status === 'RESOLVED'}}" class="hint">如问题仍未解决，补充说明后商家将继续处理。</text><view class="hint">图片附件：最多3张JPEG/PNG，合计512KB</view><button class="ghost-btn" bindtap="attach" disabled="{{busy}}">添加工单附件</button><view wx:for="{{attachments}}" wx:key="index">{{item.name}}<button class="ghost-btn" data-index="{{index}}" bindtap="removeAttachment" disabled="{{busy}}">移除</button></view><textarea value="{{reply}}" bindinput="setReply" maxlength="1000" placeholder="补充问题说明（最多1000字）" disabled="{{busy}}"/><button class="primary-btn" bindtap="reply" loading="{{busy}}" disabled="{{busy}}">补充说明</button></view><text wx:else class="hint">工单已关闭，如有新问题可新建工单。</text>
<view wx:if="{{selected.status === 'CLOSED'}}" class="satisfaction-box">
  <view class="title">服务评价</view>
  <view wx:if="{{selected.satisfaction}}">已评价：<text class="stars">{{satisfactionStars}}</text><text class="hint">{{selected.satisfaction.comment}}</text></view>
  <view wx:else>
    <view class="stars-row"><block wx:for="{{[1,2,3,4,5]}}" wx:key="*this"><text class="star {{item <= rateValue ? 'on' : ''}}" data-v="{{item}}" bindtap="setRate">★</text></block></view>
    <textarea value="{{rateComment}}" bindinput="setRateComment" maxlength="200" placeholder="说说这次的服务体验（可选，最多200字）"/>
    <button class="primary-btn" bindtap="submitRate" disabled="{{busy}}" loading="{{busy}}">提交评价</button>
  </view>
</view></view>
</view>
