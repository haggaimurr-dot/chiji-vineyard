.redeem{padding:28rpx}.title{font-size:30rpx;font-weight:700}.row{display:flex;gap:16rpx;align-items:center;margin:24rpx 0}.row input{flex:1;min-width:0;font-size:26rpx}.row button{margin:0}.hint{display:block;font-size:23rpx;line-height:1.6;color:var(--muted);margin-top:14rpx}.tabs{display:flex;gap:16rpx;margin:28rpx 0}.tabs button{margin:0;flex:1}.tabs .active{color:white;background:var(--purple)}.coupon{display:flex;gap:24rpx;padding:28rpx;margin-bottom:22rpx}.amount{color:var(--purple);font-size:44rpx;font-weight:700;min-width:170rpx}.amount text{display:block;font-size:22rpx;font-weight:400;margin-top:14rpx}.info{flex:1}.info>text{display:block;color:var(--muted);font-size:22rpx;margin-top:10rpx}.info button{margin:18rpx 0 0}.muted{opacity:.65}
.tag-new{font-size:22rpx;color:#b26a00;background:#fef3e2;border-radius:8rpx;padding:2rpx 10rpx;margin-left:12rpx;font-weight:400}
