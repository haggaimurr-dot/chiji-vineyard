<view class="page page-pad">
  <view class="card redeem"><view class="title">我的券包</view><view class="row"><input value="{{code}}" maxlength="40" placeholder="输入优惠券兑换码" bindinput="input" disabled="{{redeemBusy}}"/><button size="mini" bindtap="redeem" loading="{{redeemBusy}}" disabled="{{busy || redeemBusy || !code}}">兑换</button></view><text class="hint" wx:if="{{demo}}">演示券：DEMO10 满99减10，DEMO20 满199减20</text><text class="hint">每人每码限用一次；待付款订单占用，取消或关闭未支付订单后释放。券不抵运费。</text></view>
  <view class="tabs"><button size="mini" data-filter="usable" bindtap="filter" class="{{filter === 'usable' ? 'active' : ''}}">可使用</button><button size="mini" data-filter="other" bindtap="filter" class="{{filter === 'other' ? 'active' : ''}}">其他状态</button><button size="mini" data-filter="all" bindtap="filter" class="{{filter === 'all' ? 'active' : ''}}">全部</button></view>
  <view class="hint" wx:if="{{busy}}">正在加载券包…</view>
  <view class="empty" wx:elif="{{error}}"><text>{{error}}</text><button bindtap="load">重试</button></view>
  <view class="empty" wx:elif="{{!visible.length}}">暂无优惠券，输入兑换码加入券包</view>
  <view class="coupon card {{item.usable ? '' : 'muted'}}" wx:for="{{visible}}" wx:key="code"><view class="amount">{{item.amountText}}<text>满¥{{item.minimumText}}可用</text></view><view class="info"><view class="title">{{item.name}}<text wx:if="{{item.newUserTag}}" class="tag-new">{{item.newUserTag}}</text></view><text>{{item.code}}</text><text>{{item.startDate}} 至 {{item.endDate}}</text><text>{{item.reason}}</text><button size="mini" wx:if="{{selecting}}" data-code="{{item.code}}" bindtap="choose" disabled="{{!item.selectable || busy || redeemBusy}}">选择此券</button></view></view>
</view>
