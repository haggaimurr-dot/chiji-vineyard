.form { padding: 12rpx 30rpx; }.form label { display: grid; grid-template-columns: 145rpx 1fr; align-items: center; min-height: 100rpx; border-bottom: 1rpx solid #eee7dc; }.form label:last-child { border: 0; }.form label > text { font-weight: 700; font-size: 25rpx; }.form input,.picker { font-size: 25rpx; }.picker { display: flex; justify-content: space-between; color: #4d4842; }.form textarea { width: 100%; height: 160rpx; font-size: 25rpx; margin-top: 24rpx; }.tip { margin: 24rpx 12rpx; color: var(--muted); font-size: 21rpx; line-height: 1.6; }.save { margin-top: 36rpx; }
.address-card { padding: 28rpx; margin-bottom: 20rpx; }.recipient { font-size: 28rpx; font-weight: 700; }.recipient > text { margin-left: 16rpx; }.badge { font-size: 21rpx; color: #5b2a70; background: #f0e5f4; border-radius: 8rpx; padding: 4rpx 10rpx; }.detail { font-size: 25rpx; line-height: 1.6; margin-top: 18rpx; overflow-wrap: break-word; }.actions { display: flex; justify-content: flex-end; gap: 20rpx; margin-top: 20rpx; }.actions button { margin: 0; padding: 0 16rpx; font-size: 23rpx; color: #5b2a70; background: transparent; }.actions button::after { border: 0; }.import-btn { margin-top: 20rpx; font-size: 27rpx; color: #5b2a70; background: #fffdf8; }.empty { padding: 48rpx 28rpx; font-size: 25rpx; text-align: center; color: var(--muted); }
