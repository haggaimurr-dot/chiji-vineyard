.page{padding:24rpx;background:#f7f5ef;min-height:100vh}
.header{margin-bottom:24rpx}
.title{font-size:36rpx;font-weight:700}
.desc{font-size:24rpx;color:#999;display:block;margin-top:8rpx}
.kind-card{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:20rpx}
.kind-title{font-size:30rpx;font-weight:600;margin-bottom:16rpx}
.row{display:flex;align-items:center;gap:16rpx;padding:16rpx 0;border-top:1px solid #f0ede6}
.row text:first-child{flex:1;font-size:28rpx}
.hint{font-size:24rpx;color:#b0a892}
.empty{text-align:center;color:#999;padding:80rpx 0}
