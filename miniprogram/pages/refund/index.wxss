.notice,.form { padding: 28rpx; }.notice view { color: var(--purple); font-weight: 700; }.notice text { display: block; margin-top: 12rpx; color: var(--muted); font-size: 23rpx; line-height: 1.7; }.form { margin-top: 22rpx; }.form label { display: block; margin-bottom: 28rpx; }.form label:last-child { margin: 0; }.form label > text { font-weight: 700; }.form picker view { display: flex; justify-content: space-between; margin-top: 14rpx; padding: 22rpx; border-radius: 14rpx; background: #f2eee6; }.form textarea { margin-top: 14rpx; padding: 22rpx; width: 100%; height: 180rpx; border-radius: 14rpx; background: #f2eee6; }.submit { margin-top: 34rpx; }


.refresh{margin:24rpx 0}.progress{padding:28rpx;margin-top:24rpx}.heading{display:flex;justify-content:space-between;color:var(--purple);font-weight:700;margin-bottom:24rpx}.steps{display:flex;flex-wrap:wrap;gap:20rpx;margin:22rpx 0}.step{font-size:23rpx;color:var(--muted)}.step.done{color:var(--purple)}.hint,.detail,.reject{display:block;font-size:24rpx;line-height:1.8;overflow-wrap:anywhere}.hint,.detail{color:var(--muted)}.detail{margin-top:8rpx}.reject,.error{color:#a33d39}.error{font-size:25rpx;line-height:1.7}.form textarea{box-sizing:border-box}

.form input{margin-top:14rpx;padding:22rpx;border-radius:14rpx;background:#f2eee6}.form .hint{display:block;margin:14rpx 0;color:var(--muted);font-size:23rpx;font-weight:400;line-height:1.6}.evidence-grid{display:flex;flex-wrap:wrap;gap:16rpx;margin:20rpx 0}.evidence-item{width:170rpx}.evidence-item image{width:170rpx;height:170rpx;border-radius:12rpx}.evidence-item button{font-size:22rpx}.error{margin-top:24rpx;color:#9c3434;font-size:25rpx}
