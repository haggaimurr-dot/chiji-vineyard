.service-card{margin:24rpx 0;padding:30rpx;background:#fff;border-radius:24rpx;color:#41372f}.heading{font-size:30rpx;font-weight:600;margin-bottom:16rpx}.demo{background:#fff3d9;color:#806123;padding:16rpx;border-radius:12rpx;font-size:23rpx;line-height:1.7;margin-bottom:18rpx}.muted,.identity{font-size:25rpx;color:#746b62;line-height:1.9;word-break:break-all}.identity{border-top:1rpx solid #eee6dd;margin-top:20rpx;padding-top:20rpx}.actions{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:18rpx}button{font-size:25rpx;background:#f6f2eb;color:#554c43;margin:0}.policy{margin-top:20rpx}button::after{border:0}
