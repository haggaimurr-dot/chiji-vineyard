{
  "name": "chiji-grape",
  "version": "0.1.0",
  "private": true,
  "description": "迟记葡萄牙微信小程序、Go 云托管后端与运营后台",
  "workspaces": [
    "admin"
  ],
  "scripts": {
    "game:build": "node minigame/scripts/build.cjs",
    "game:preview": "node minigame/scripts/preview.cjs",
    "test:game": "node tests/vineyard-game-model.cjs && node tests/vineyard-game-service.cjs && node tests/vineyard-game-native.cjs && node tests/vineyard-game-entry.cjs",
    "test:game-ui": "node tests/vineyard-game-ui.cjs",
    "test:game-field": "node tests/vineyard-field-model.cjs && node tests/vineyard-field-navigation.cjs",
    "test:game-field-ui": "node tests/vineyard-field-ui.cjs",
    "test:game-field-native": "node tests/vineyard-field-native.cjs",
    "test:personal-data": "node tests/personal-data.cjs",
    "test:runtime": "node tests/runtime-operations.cjs",
    "test:waybills": "node tests/waybill-features.cjs && node tests/order-operations.cjs",
    "test:dashboard": "node tests/dashboard-features.cjs && node tests/commerce-analytics.cjs",
    "test:dashboard-ui": "node tests/dashboard-ui.cjs",
    "test:inventory": "node tests/inventory-features.cjs && node tests/inventory-lots.cjs",
    "test:inventory-ui": "node tests/inventory-ui.cjs",
    "test:cart": "node tests/flows.cjs --cart-only",
    "test:coupons": "node tests/coupon-wallet.cjs && node tests/coupon-wallet-backend.cjs",
    "test:identity": "node tests/identity-features.cjs",
    "test:classroom": "node tests/classroom-learning.cjs && node tests/classroom-series.cjs",
    "test:classroom-ui": "node tests/classroom-questions-ui.cjs",
    "test:invoices": "node tests/invoice-download.cjs && node tests/flows.cjs --invoice-only",
    "test:home-features": "node tests/home-features.cjs",
    "test:home-ui": "node tests/home-ui.cjs",
    "test:shop": "node tests/shop-pagination.cjs && node tests/flows.cjs --products-only",
    "test:restock": "node tests/restock-features.cjs",
    "test:price-drop": "node tests/price-drop-features.cjs",
    "test:reviews": "node tests/review-pagination.cjs && node tests/review-features.cjs",
    "test:operations": "node tests/admin-account-flows.cjs && node tests/cross-end-updates.cjs",
    "test:config-history": "node tests/config-history.cjs",
    "admin:dev": "npm --workspace admin run dev",
    "admin:build": "npm --workspace admin run build",
    "admin:typecheck": "npm --workspace admin run typecheck",
    "mini:typecheck": "tsc -p miniprogram/tsconfig.json --noEmit",
    "check": "npm run mini:typecheck && npm run admin:typecheck && npm run admin:build",
    "test:flows": "node tests/flows.cjs && node tests/order-features.cjs && node tests/order-operations.cjs",
    "mini:build": "tsc -p miniprogram/tsconfig.json",
    "test:after-sales-ui": "node tests/after-sales-ui.cjs",
    "test:after-sales": "node tests/after-sales-features.cjs",
    "test:refunds": "node tests/refund-flows.cjs",
    "test:leads": "node tests/lead-features.cjs",
    "test:content": "node tests/content-admin.cjs && node tests/content-features.cjs && node tests/content-flows.cjs && node tests/admin-video.cjs",
    "test:product-memory": "node tests/product-memory.cjs",
    "test:checkout": "node tests/checkout-settlement.cjs",
    "test:payments": "node tests/payment-operations.cjs",
    "test:account-security": "node tests/account-security.cjs",
    "test:content-ui": "node tests/content-management-ui.cjs",
    "test:product-management": "node tests/product-management-ui.cjs",
    "test:inventory-mysql": "cd backend && go test -run TestInventoryMySQLAcceptance -count=1 -v",
    "test:batches": "node tests/order-batches.cjs && node tests/batch-qr.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "jsqr": "^1.4.0",
    "miniprogram-api-typings": "^4.0.7",
    "playwright": "^1.64.0",
    "three": "0.162.0",
    "typescript": "^5.9.2"
  }
}
