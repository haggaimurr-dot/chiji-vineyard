# 配置在云托管 Go 服务环境中，勿提交真实密钥。
MYSQL_DSN=chiji:password@tcp(mysql-host:3306)/chiji?parseTime=true&loc=UTC&charset=utf8mb4&time_zone=%27%2B00%3A00%27
PUBLIC_BASE_URL=https://api.example.com
PORT=8080
# 电子发票邮件：465 使用 tls，587 使用 starttls；填写邮箱授权码。
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS_MODE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 独立微信小游戏身份：不得填商城小程序 AppID/secret；只在服务端配置。
WECHAT_GAME_APP_ID=
WECHAT_GAME_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL_NO=
WECHAT_MCH_PRIVATE_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_REFUND_NOTIFY_URL=

# 服务安全配置
TOKEN_SECRET=replace-with-a-32-byte-or-longer-random-secret
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-one-time-bootstrap-secret
INTERNAL_JOB_SECRET=replace-with-an-independent-random-secret
ADMIN_ALLOWED_ORIGIN=https://admin.example.com

# PC 后台构建变量（admin/.env.local）
VITE_API_BASE_URL=
VITE_USE_MOCK=false

# 快递100实时轨迹查询（仅服务端）
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=

# 快递100电子面单 V2（仅服务端；沿用企业 KEY，SECRET 与轨迹 CUSTOMER 不同）
# 须开通电子面单额度、向快递网点取得账号、在企业后台配置 V2 图片模板。
KUAIDI100_SECRET=
KUAIDI100_SENDER_NAME=
KUAIDI100_SENDER_PHONE=
KUAIDI100_SENDER_ADDRESS=
# 仅配置已签约的网点/月结账号；模板、产品、付款方式按网点实际权限填写。
# SF/YTO/ZTO/STO/YD/EMS/JD/JT；前端只会看到已配置完整的承运商名称。
# 顺丰示例；真实密钥不得写入仓库。顺丰需要 partnerKey、partnerSecret；ZTO/STO 还需 net。
KUAIDI100_WAYBILL_ACCOUNTS={"SF":{"partnerId":"","partnerKey":"","partnerSecret":"","tempId":"","expType":"顺丰标快","payType":"MONTHLY"}}

# 微信发货订阅消息；字段编号必须与微信后台选用的模板一致
WECHAT_SHIPPING_TEMPLATE_ID=
WECHAT_SHIPPING_TEMPLATE_FIELDS={"character_string1":"orderNo","thing2":"carrier","character_string3":"trackingNo","time4":"shippedAt"}
WECHAT_MINIPROGRAM_STATE=formal

# 微信到货一次性订阅消息；字段编号必须与实际模板一致
WECHAT_RESTOCK_TEMPLATE_ID=
WECHAT_RESTOCK_TEMPLATE_FIELDS={"thing1":"product","thing2":"remark","time3":"restockedAt"}

# 微信活动开始一次性订阅消息；字段编号必须与实际模板一致
WECHAT_ACTIVITY_TEMPLATE_ID=
WECHAT_ACTIVITY_TEMPLATE_FIELDS={"thing1":"title","thing2":"location","date3":"startDate","thing4":"remark"}

# 微信降价一次性订阅消息；按实际模板编号映射字段
WECHAT_PRICE_DROP_TEMPLATE_ID=
WECHAT_PRICE_DROP_TEMPLATE_FIELDS={"thing1":"product","thing2":"sku","amount3":"baselinePrice","amount4":"currentPrice","time5":"detectedAt"}

# Comma-separated CIDRs of actual reverse proxies allowed to supply X-Forwarded-For.
# Empty means only the direct peer is used for login source limiting.
LOGIN_TRUSTED_PROXY_CIDRS=

# Application-owned invoice gateway, see docs/AUTO_INVOICE_AND_TICKETS.md
AUTO_INVOICE_ENABLED=false
INVOICE_GATEWAY_URL=
INVOICE_GATEWAY_TOKEN=

# CRM 到期提醒网关（服务端配置；需同时设置 URL/token 并在线索中开启）
CRM_REMINDER_GATEWAY_URL=
CRM_REMINDER_GATEWAY_TOKEN=
